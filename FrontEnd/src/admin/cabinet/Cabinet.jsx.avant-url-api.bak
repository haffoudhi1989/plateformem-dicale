import React, { useEffect, useMemo, useState } from "react";

import { useNavigate, useSearchParams } from "react-router-dom";
import {
    Search,
    Building2,
    Stethoscope,
    Users,
    Save,
    X,
    CheckCircle2,
    AlertCircle,
    Loader2,
    UserRound,
} from "lucide-react";

const BASE_URL = import.meta.env.VITE_API_URL || "http://localhost:8000/api";
const API_CABINETS = `${BASE_URL}/cabinets`;
const API_MEDECINS = `${BASE_URL}/medecins`;
const API_PATIENTS = `${BASE_URL}/patients`;
const API_SECRETAIRES = `${BASE_URL}/secretaires`;

const getAuthToken = () =>
    localStorage.getItem("token") ||
    localStorage.getItem("access_token") ||
    localStorage.getItem("auth_token") ||
    localStorage.getItem("userToken") ||
    sessionStorage.getItem("token") ||
    sessionStorage.getItem("access_token");

const EMPTY_FORM = {
    nom: "",
    adresse: "",
    telephone: "",
    email: "",
    description: "",
    actif: true,
};

function Cabinet() {
    const navigate = useNavigate();
    const [searchParams] = useSearchParams();
    // =====================================================
    // ETATS
    // =====================================================

    const [cabinets, setCabinets] = useState([]);

    const [cabinetId, setCabinetId] = useState(null);

    const [medecins, setMedecins] = useState([]);
    const [patients, setPatients] = useState([]);
    const [secretaires, setSecretaires] = useState([]);

    const [selectedMedecins, setSelectedMedecins] = useState([]);
    const [selectedPatients, setSelectedPatients] = useState([]);
    const [selectedSecretaires, setSelectedSecretaires] = useState([]);

    const [searchMedecin, setSearchMedecin] = useState("");
    const [searchPatient, setSearchPatient] = useState("");
    const [searchSecretaire, setSearchSecretaire] = useState("");

    const [openList, setOpenList] = useState(null);

    const [form, setForm] = useState(EMPTY_FORM);

    const [loading, setLoading] = useState(true);
    const [saving, setSaving] = useState(false);

    const [feedback, setFeedback] = useState(null);

    // =====================================================
    // UTILITAIRE REPONSE API
    // =====================================================

    const extractData = (result) => {
        if (Array.isArray(result?.data)) {
            return result.data;
        }

        if (Array.isArray(result)) {
            return result;
        }

        return [];
    };

    // =====================================================
    // CHARGER LISTES
    // =====================================================

    const loadLists = async () => {
        const [
            cabinetsResponse,
            medecinsResponse,
            patientsResponse,
            secretairesResponse,
        ] = await Promise.all([
            fetch(API_CABINETS, {
                headers: {
                    Accept: "application/json",
                    Authorization: `Bearer ${getAuthToken()}`,
                },
            }),

            fetch(API_MEDECINS, {
                headers: {
                    Accept: "application/json",
                    Authorization: `Bearer ${getAuthToken()}`,
                },
            }),

            fetch(API_PATIENTS, {
                headers: {
                    Accept: "application/json",
                    Authorization: `Bearer ${getAuthToken()}`,
                },
            }),

            fetch(API_SECRETAIRES, {
                headers: {
                    Accept: "application/json",
                    Authorization: `Bearer ${getAuthToken()}`,
                },
            }),
        ]);

        const [
            cabinetsResult,
            medecinsResult,
            patientsResult,
            secretairesResult,
        ] = await Promise.all([
            cabinetsResponse.json(),
            medecinsResponse.json(),
            patientsResponse.json(),
            secretairesResponse.json(),
        ]);

        if (!cabinetsResponse.ok) {
            throw new Error(
                cabinetsResult?.message ||
                    "Impossible de charger les cabinets."
            );
        }

        if (!medecinsResponse.ok) {
            throw new Error(
                medecinsResult?.message ||
                    "Impossible de charger les médecins."
            );
        }

        if (!patientsResponse.ok) {
            throw new Error(
                patientsResult?.message ||
                    "Impossible de charger les patients."
            );
        }

        if (!secretairesResponse.ok) {
            throw new Error(
                secretairesResult?.message ||
                    "Impossible de charger les secrétaires."
            );
        }

        setCabinets(extractData(cabinetsResult));
        setMedecins(extractData(medecinsResult));
        setPatients(extractData(patientsResult));
        setSecretaires(extractData(secretairesResult));

        return {
            cabinets: extractData(cabinetsResult),
            medecins: extractData(medecinsResult),
            patients: extractData(patientsResult),
            secretaires: extractData(secretairesResult),
        };
    };

    // =====================================================
    // CHARGER UN CABINET
    // =====================================================

    const loadCabinet = async (id) => {
        if (!id) {
            setCabinetId(null);
            setForm({ ...EMPTY_FORM });

            setSelectedMedecins([]);
            setSelectedPatients([]);
            setSelectedSecretaires([]);

            return;
        }

        try {
            setLoading(true);

            const response = await fetch(`${API_CABINETS}/${id}`, {
                headers: {
                    Accept: "application/json",
                    Authorization: `Bearer ${getAuthToken()}`,
                },
            });

            const result = await response.json();

            if (!response.ok) {
                throw new Error(
                    result?.message ||
                        "Impossible de charger le cabinet."
                );
            }

            const cabinet = result?.data || result;

            setCabinetId(Number(cabinet.id));

            setForm({
                nom: cabinet.nom || "",
                adresse: cabinet.adresse || "",
                telephone: cabinet.telephone || "",
                email: cabinet.email || "",
                description: cabinet.description || "",
                actif:
                    cabinet.actif === undefined
                        ? true
                        : Boolean(cabinet.actif),
            });

            /*
             * Le backend doit idéalement retourner :
             *
             * medecins: [...]
             * patients: [...]
             * secretaires: [...]
             *
             * On accepte également :
             *
             * medecin_ids
             * patient_ids
             * secretaire_ids
             */

            let medecinIds = [];
            let patientIds = [];
            let secretaireIds = [];

            if (Array.isArray(cabinet.medecin_ids)) {
                medecinIds = cabinet.medecin_ids;
            } else if (Array.isArray(cabinet.medecins)) {
                medecinIds = cabinet.medecins.map((item) => item.id);
            }

            if (Array.isArray(cabinet.patient_ids)) {
                patientIds = cabinet.patient_ids;
            } else if (Array.isArray(cabinet.patients)) {
                patientIds = cabinet.patients.map((item) => item.id);
            }

            if (Array.isArray(cabinet.secretaire_ids)) {
                secretaireIds = cabinet.secretaire_ids;
            } else if (Array.isArray(cabinet.secretaires)) {
                secretaireIds = cabinet.secretaires.map(
                    (item) => item.id
                );
            }

            setSelectedMedecins(
                medecinIds
                    .map(Number)
                    .filter(Boolean)
                    .slice(0, 1)
            );

            setSelectedPatients(
                patientIds.map(Number).filter(Boolean)
            );

            setSelectedSecretaires(
                secretaireIds.map(Number).filter(Boolean)
            );

            setFeedback(null);
        } catch (error) {
            console.error("Erreur loadCabinet:", error);

            setFeedback({
                type: "error",
                text:
                    error.message ||
                    "Impossible de charger le cabinet.",
            });
        } finally {
            setLoading(false);
        }
    };

    // =====================================================
    // CHARGEMENT INITIAL
    // =====================================================

    useEffect(() => {
        const init = async () => {
            try {
                setLoading(true);

                const data = await loadLists();

                const requestedId = Number(
                    searchParams.get("cabinet")
                );

                if (
                    requestedId &&
                    data.cabinets.some(
                        (cabinet) =>
                            Number(cabinet.id) === requestedId
                    )
                ) {
                    await loadCabinet(requestedId);
                } else {
                    setCabinetId(null);
                    setForm({ ...EMPTY_FORM });

                    setSelectedMedecins([]);
                    setSelectedPatients([]);
                    setSelectedSecretaires([]);

                    setLoading(false);
                }
            } catch (error) {
                console.error("Erreur initialisation:", error);

                setFeedback({
                    type: "error",
                    text:
                        error.message ||
                        "Impossible de charger les données.",
                });

                setLoading(false);
            }
        };

        init();

        // eslint-disable-next-line react-hooks/exhaustive-deps
    }, []);

    // =====================================================
    // FILTRES
    // =====================================================

    const filteredMedecins = useMemo(() => {
        const search = searchMedecin.toLowerCase().trim();

        return medecins.filter((medecin) => {
            const text = `
                ${medecin.prenom || ""}
                ${medecin.nom || ""}
                ${medecin.email || ""}
                ${medecin.specialite?.nom || ""}
            `.toLowerCase();

            return text.includes(search);
        });
    }, [medecins, searchMedecin]);

    const filteredPatients = useMemo(() => {
        const search = searchPatient.toLowerCase().trim();

        return patients.filter((patient) => {
            const text = `
                ${patient.prenom || ""}
                ${patient.nom || ""}
                ${patient.email || ""}
                ${patient.telephone || ""}
            `.toLowerCase();

            return text.includes(search);
        });
    }, [patients, searchPatient]);

    const filteredSecretaires = useMemo(() => {
        const search = searchSecretaire.toLowerCase().trim();

        return secretaires.filter((secretaire) => {
            const text = `
                ${secretaire.prenom || ""}
                ${secretaire.nom || ""}
                ${secretaire.email || ""}
                ${secretaire.telephone || ""}
            `.toLowerCase();

            return text.includes(search);
        });
    }, [secretaires, searchSecretaire]);

    // =====================================================
    // TOGGLE MEDECINS
    // =====================================================

    const toggleMedecin = (id) => {
        const numericId = Number(id);

        // Règle métier : un cabinet = plusieurs patients + UN SEUL médecin.
        // Sélectionner un médecin remplace la sélection précédente.
        setSelectedMedecins((previous) => {
            if (previous.includes(numericId)) {
                return [];
            }

            return [numericId];
        });
    };

    // =====================================================
    // TOGGLE PATIENTS
    // =====================================================

    const togglePatient = (id) => {
        const numericId = Number(id);

        setSelectedPatients((previous) => {
            if (previous.includes(numericId)) {
                return previous.filter(
                    (item) => item !== numericId
                );
            }

            return [...previous, numericId];
        });
    };

    // =====================================================
    // TOGGLE SECRETaires
    // =====================================================

    const toggleSecretaire = (id) => {
        const numericId = Number(id);

        setSelectedSecretaires((previous) => {
            if (previous.includes(numericId)) {
                return previous.filter(
                    (item) => item !== numericId
                );
            }

            return [...previous, numericId];
        });
    };

    // =====================================================
    // NOUVEAU CABINET
    // =====================================================

    const handleNewCabinet = () => {
        setCabinetId(null);

        setForm({
            ...EMPTY_FORM,
        });

        setSelectedMedecins([]);
        setSelectedPatients([]);
        setSelectedSecretaires([]);

        setSearchMedecin("");
        setSearchPatient("");
        setSearchSecretaire("");

        setOpenList(null);
        setFeedback(null);
    };

    // =====================================================
    // VALIDATION
    // =====================================================

    const validateForm = () => {
        if (!form.nom.trim()) {
            return "Le nom du cabinet est obligatoire.";
        }

        if (selectedMedecins.length === 0) {
            return "Veuillez sélectionner un médecin (un seul par cabinet).";
        }

        if (selectedMedecins.length > 1) {
            return "Un cabinet doit contenir un seul médecin.";
        }

        if (selectedSecretaires.length === 0) {
            return "Veuillez sélectionner au moins une secrétaire.";
        }

        return null;
    };

    // =====================================================
    // PAYLOAD
    // =====================================================

    const buildPayload = () => {
        return {
            nom: form.nom.trim(),
            adresse: form.adresse.trim() || null,
            telephone: form.telephone.trim() || null,
            email: form.email.trim() || null,
            description: form.description.trim() || null,
            actif: Boolean(form.actif),

            /*
             * IMPORTANT :
             * On envoie des TABLEAUX.
             *
             * PAS :
             * medecin_id
             * patient_id
             * secretaire_id
             *
             * MAIS :
             * medecin_ids
             * patient_ids
             * secretaire_ids
             */

            medecin_ids: selectedMedecins.map(Number),
            patient_ids: selectedPatients.map(Number),
            secretaire_ids: selectedSecretaires.map(Number),
        };
    };

    // =====================================================
    // ENREGISTRER
    // =====================================================

    const handleSave = async () => {
        const validationError = validateForm();

        if (validationError) {
            setFeedback({
                type: "error",
                text: validationError,
            });

            return;
        }

        setSaving(true);
        setFeedback(null);

        const isNew = !cabinetId;

        const payload = buildPayload();

        console.log(
            "Payload cabinet envoyé :",
            payload
        );

        try {
            const url = isNew
                ? API_CABINETS
                : `${API_CABINETS}/${cabinetId}`;

            const response = await fetch(url, {
                method: isNew ? "POST" : "PUT",

                headers: {
                    "Content-Type": "application/json",
                    Accept: "application/json",
                    Authorization: `Bearer ${getAuthToken()}`,
                },

                body: JSON.stringify(payload),
            });

            let result = null;

            try {
                result = await response.json();
            } catch {
                result = {};
            }

            console.log(
                "Réponse API cabinet :",
                result
            );

            if (!response.ok) {
                const validationMessages =
                    result?.errors
                        ? Object.values(result.errors)
                              .flat()
                              .join(" ")
                        : "";

                throw new Error(
                    validationMessages ||
                        result?.message ||
                        "Erreur lors de l'enregistrement du cabinet."
                );
            }

            const savedCabinet =
                result?.data || result;

            const savedId = savedCabinet?.id;

            // Nouveau cabinet : redirection vers la liste
            if (isNew) {
                navigate("/admin/cabinet/liste");
                return;
            }

            await loadLists();

            if (savedId) {
                await loadCabinet(savedId);
            } else if (cabinetId) {
                await loadCabinet(cabinetId);
            }

            setFeedback({
                type: "success",
                text: isNew
                    ? "Cabinet créé avec succès."
                    : "Cabinet modifié avec succès.",
            });
        } catch (error) {
            console.error(
                "Erreur handleSave:",
                error
            );

            setFeedback({
                type: "error",
                text:
                    error.message ||
                    "Erreur lors de l'enregistrement du cabinet.",
            });
        } finally {
            setSaving(false);
        }
    };

    // =====================================================
    // ANNULER
    // =====================================================

    const handleCancel = async () => {
        setOpenList(null);

        if (cabinetId) {
            await loadCabinet(cabinetId);
        } else {
            setForm({
                ...EMPTY_FORM,
            });

            setSelectedMedecins([]);
            setSelectedPatients([]);
            setSelectedSecretaires([]);
        }

        setFeedback(null);
    };

    // =====================================================
    // CLASSE INPUT
    // =====================================================

    const inputClass = `w-full px-4 py-2 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-900 placeholder-slate-400 outline-none transition focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10`;

    // =====================================================
    // RENDER
    // =====================================================

    return (
    <div className="overflow-x-clip">            {/* =================================================
                HEADER
            ================================================= */}

                        <div className="rounded-2xl bg-gradient-to-r from-[#26415E] to-[#3A5570] shadow-lg shadow-blue-200/60 p-4 md:p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-3 min-h-[88px] md:min-h-[96px] mb-4">
                <div className="flex items-center gap-4">
                    <div className="w-14 h-14 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center shrink-0">
                        <Building2 size={26} className="text-white" />
                    </div>
                    <div>
                        <h1 className="text-lg md:text-xl font-bold text-white mt-0.5">
                            Gestion du cabinet
                        </h1>
                        <p className="text-blue-100 text-sm mt-0.5">
                            Informations et gestion des membres
                        </p>
                    </div>
                </div>
            </div>

            {/* =================================================
                CONTENU
            ================================================= */}

            {loading ? (
                <div
                    className="
                        bg-white
                        rounded-2xl
                        border
                        border-slate-200
                        shadow-sm
                        p-16
                        text-center
                    "
                >
                    <Loader2
                        size={32}
                        className="
                            text-blue-500
                            mx-auto
                            mb-3
                            animate-spin
                        "
                    />

                    <p
                        className="
                            text-sm
                            text-slate-400
                            font-medium
                        "
                    >
                        Chargement du cabinet...
                    </p>
                </div>
            ) : (
                <div
                    className="
                        bg-white
                        rounded-2xl
                        border
                        border-slate-200
                        shadow-sm
                        overflow-hidden
                    "
                >

                    {/* =================================================
                        INFORMATIONS
                    ================================================= */}

                    <div className="p-4 md:p-5">

                        <div className="flex items-center gap-3 mb-3">

                            <div className="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                                <Building2 size={19} />
                            </div>

                            <div>

                                <h2
                                    className="
                                        font-bold
                                        text-slate-900
                                    "
                                >
                                    {cabinetId
                                        ? "Modifier le cabinet"
                                        : "Créer un cabinet"}
                                </h2>

                                <p
                                    className="
                                        text-xs
                                        text-slate-400
                                        mt-0.5
                                    "
                                >
                                    Informations générales du cabinet
                                </p>
                            </div>
                        </div>

                        <div
                            className="
                                grid
                                grid-cols-1
                                md:grid-cols-3
                                gap-3
                            "
                        >

                            {/* NOM */}

                            <div>
                                <label className="block text-[13px] font-semibold text-slate-700 mb-1.5">
                                    Nom du cabinet *
                                </label>

                                <input
                                    type="text"
                                    value={form.nom}
                                    onChange={(e) =>
                                        setForm({
                                            ...form,
                                            nom: e.target.value,
                                        })
                                    }
                                    placeholder="Nom du cabinet"
                                    className={inputClass}
                                />
                            </div>

                            {/* ADRESSE */}

                            <div>
                                <label className="block text-[13px] font-semibold text-slate-700 mb-1.5">
                                    Adresse
                                </label>

                                <input
                                    type="text"
                                    value={form.adresse}
                                    onChange={(e) =>
                                        setForm({
                                            ...form,
                                            adresse: e.target.value,
                                        })
                                    }
                                    placeholder="Adresse"
                                    className={inputClass}
                                />
                            </div>

                            {/* TELEPHONE */}

                            <div>
                                <label className="block text-[13px] font-semibold text-slate-700 mb-1.5">
                                    Téléphone
                                </label>

                                <input
                                    type="text"
                                    value={form.telephone}
                                    onChange={(e) =>
                                        setForm({
                                            ...form,
                                            telephone:
                                                e.target.value,
                                        })
                                    }
                                    placeholder="Téléphone"
                                    className={inputClass}
                                />
                            </div>

                            {/* EMAIL */}

                            <div>
                                <label className="block text-[13px] font-semibold text-slate-700 mb-1.5">
                                    Email
                                </label>

                                <input
                                    type="email"
                                    value={form.email}
                                    onChange={(e) =>
                                        setForm({
                                            ...form,
                                            email: e.target.value,
                                        })
                                    }
                                    placeholder="email@exemple.com"
                                    className={inputClass}
                                />
                            </div>

                            {/* DESCRIPTION */}

                            <div className="md:col-span-2">

                                <label className="block text-[13px] font-semibold text-slate-700 mb-1.5">
                                    Description
                                </label>

                                <input
                                    type="text"
                                    value={form.description}
                                    onChange={(e) =>
                                        setForm({
                                            ...form,
                                            description:
                                                e.target.value,
                                        })
                                    }
                                    placeholder="Description"
                                    className={inputClass}
                                />
                            </div>
                        </div>

                        {/* STATUT */}

                        <div className="mt-3">

                            <label className="block text-[13px] font-semibold text-slate-700 mb-1.5">
                                Statut
                            </label>

                            <div className="flex gap-3">

                                <button
                                    type="button"
                                    onClick={() =>
                                        setForm({
                                            ...form,
                                            actif: true,
                                        })
                                    }
                                    className={`
                                        inline-flex
                                        items-center
                                        gap-2
                                        px-4
                                        py-1.5
                                        rounded-xl
                                        text-sm
                                        font-semibold
                                        border
                                        transition

                                        ${
                                            form.actif
                                                ? "bg-emerald-50 border-emerald-200 text-emerald-700"
                                                : "border-slate-200 text-slate-400 hover:bg-slate-50"
                                        }
                                    `}
                                >
                                    <span
                                        className="
                                            w-2.5
                                            h-2.5
                                            rounded-full
                                            bg-emerald-500
                                        "
                                    />

                                    Actif
                                </button>

                                <button
                                    type="button"
                                    onClick={() =>
                                        setForm({
                                            ...form,
                                            actif: false,
                                        })
                                    }
                                    className={`
                                        inline-flex
                                        items-center
                                        gap-2
                                        px-4
                                        py-1.5
                                        rounded-xl
                                        text-sm
                                        font-semibold
                                        border
                                        transition

                                        ${
                                            !form.actif
                                                ? "bg-amber-50 border-amber-200 text-amber-700"
                                                : "border-slate-200 text-slate-400 hover:bg-slate-50"
                                        }
                                    `}
                                >
                                    <span
                                        className="
                                            w-2.5
                                            h-2.5
                                            rounded-full
                                            bg-amber-500
                                        "
                                    />

                                    En attente
                                </button>
                            </div>
                        </div>
                    </div>

                    <div className="border-t border-slate-200" />

                    {/* =================================================
                        MEMBRES
                    ================================================= */}

                    <div className="p-4 md:p-5">

                        <div className="flex items-center gap-3 mb-3">

                            <div className="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                                <Users size={19} />
                            </div>

                            <div>

                                <h2
                                    className="
                                        font-bold
                                        text-slate-900
                                    "
                                >
                                    Membres du cabinet
                                </h2>

                                <p
                                    className="
                                        text-xs
                                        text-slate-400
                                        mt-0.5
                                    "
                                >
                                    Vous pouvez sélectionner plusieurs
                                    médecins, patients et secrétaires.
                                </p>
                            </div>
                        </div>

                        <div
                            className="
                                grid
                                grid-cols-1
                                md:grid-cols-3
                                gap-3
                            "
                        >

                            {/* =================================================
                                MEDECINS
                            ================================================= */}

                            <button
                                type="button"
                                onClick={() =>
                                    setOpenList("medecins")
                                }
                                className="
                                    flex
                                    items-center
                                    gap-3
                                    p-2.5
                                    rounded-2xl
                                    border
                                    border-slate-200
                                    bg-slate-50
                                    hover:border-blue-300
                                    hover:bg-blue-50
                                    transition
                                    text-left
                                "
                            >
                                <div
                                    className="
                                        w-9
                                        h-9
                                        rounded-xl
                                        bg-white
                                        border
                                        border-slate-200
                                        flex
                                        items-center
                                        justify-center
                                    "
                                >
                                    <Stethoscope
                                        size={19}
                                        className="text-blue-600"
                                    />
                                </div>

                                <div className="flex-1">

                                    <div
                                        className="
                                            text-sm
                                            font-bold
                                            text-slate-800
                                        "
                                    >
                                        Médecin (1 seul)
                                    </div>

                                    <div
                                        className="
                                            text-xs
                                            text-slate-400
                                            mt-1
                                        "
                                    >
                                        {selectedMedecins.length}
                                        {" / 1 sélectionné"}
                                    </div>
                                </div>

                                <span
                                    className="
                                        min-w-8
                                        h-8
                                        px-2
                                        rounded-full
                                        bg-blue-600
                                        text-white
                                        flex
                                        items-center
                                        justify-center
                                        text-xs
                                        font-bold
                                    "
                                >
                                    {selectedMedecins.length}
                                </span>
                            </button>

                            {/* =================================================
                                PATIENTS
                            ================================================= */}

                            <button
                                type="button"
                                onClick={() =>
                                    setOpenList("patients")
                                }
                                className="
                                    flex
                                    items-center
                                    gap-3
                                    p-2.5
                                    rounded-2xl
                                    border
                                    border-slate-200
                                    bg-slate-50
                                    hover:border-violet-300
                                    hover:bg-violet-50
                                    transition
                                    text-left
                                "
                            >
                                <div
                                    className="
                                        w-9
                                        h-9
                                        rounded-xl
                                        bg-white
                                        border
                                        border-slate-200
                                        flex
                                        items-center
                                        justify-center
                                    "
                                >
                                    <Users
                                        size={19}
                                        className="text-violet-600"
                                    />
                                </div>

                                <div className="flex-1">

                                    <div
                                        className="
                                            text-sm
                                            font-bold
                                            text-slate-800
                                        "
                                    >
                                        Patients
                                    </div>

                                    <div
                                        className="
                                            text-xs
                                            text-slate-400
                                            mt-1
                                        "
                                    >
                                        {selectedPatients.length}{" "}
                                        sélectionné(s)
                                    </div>
                                </div>

                                <span
                                    className="
                                        min-w-8
                                        h-8
                                        px-2
                                        rounded-full
                                        bg-violet-600
                                        text-white
                                        flex
                                        items-center
                                        justify-center
                                        text-xs
                                        font-bold
                                    "
                                >
                                    {selectedPatients.length}
                                </span>
                            </button>

                            {/* =================================================
                                SECRETaires
                            ================================================= */}

                            <button
                                type="button"
                                onClick={() =>
                                    setOpenList("secretaires")
                                }
                                className="
                                    flex
                                    items-center
                                    gap-3
                                    p-2.5
                                    rounded-2xl
                                    border
                                    border-slate-200
                                    bg-slate-50
                                    hover:border-teal-300
                                    hover:bg-teal-50
                                    transition
                                    text-left
                                "
                            >
                                <div
                                    className="
                                        w-9
                                        h-9
                                        rounded-xl
                                        bg-white
                                        border
                                        border-slate-200
                                        flex
                                        items-center
                                        justify-center
                                    "
                                >
                                    <UserRound
                                        size={19}
                                        className="text-teal-600"
                                    />
                                </div>

                                <div className="flex-1">

                                    <div
                                        className="
                                            text-sm
                                            font-bold
                                            text-slate-800
                                        "
                                    >
                                        Secrétaires
                                    </div>

                                    <div
                                        className="
                                            text-xs
                                            text-slate-400
                                            mt-1
                                        "
                                    >
                                        {selectedSecretaires.length}{" "}
                                        sélectionné(s)
                                    </div>
                                </div>

                                <span
                                    className="
                                        min-w-8
                                        h-8
                                        px-2
                                        rounded-full
                                        bg-teal-600
                                        text-white
                                        flex
                                        items-center
                                        justify-center
                                        text-xs
                                        font-bold
                                    "
                                >
                                    {selectedSecretaires.length}
                                </span>
                            </button>
                        </div>
                    </div>

                    {/* =================================================
                        MODALE
                    ================================================= */}

                    {openList && (
                        <SelectionModal
                            openList={openList}
                            setOpenList={setOpenList}
                            filteredMedecins={filteredMedecins}
                            filteredPatients={filteredPatients}
                            filteredSecretaires={
                                filteredSecretaires
                            }
                            selectedMedecins={
                                selectedMedecins
                            }
                            selectedPatients={
                                selectedPatients
                            }
                            selectedSecretaires={
                                selectedSecretaires
                            }
                            toggleMedecin={
                                toggleMedecin
                            }
                            togglePatient={
                                togglePatient
                            }
                            toggleSecretaire={
                                toggleSecretaire
                            }
                            searchMedecin={
                                searchMedecin
                            }
                            setSearchMedecin={
                                setSearchMedecin
                            }
                            searchPatient={
                                searchPatient
                            }
                            setSearchPatient={
                                setSearchPatient
                            }
                            searchSecretaire={
                                searchSecretaire
                            }
                            setSearchSecretaire={
                                setSearchSecretaire
                            }
                        />
                    )}

                    {/* =================================================
                        FEEDBACK
                    ================================================= */}

                    {feedback && (
                        <div className="px-6 md:px-8 pb-3">

                            <div
                                className={`
                                    flex
                                    items-start
                                    gap-3
                                    p-4
                                    rounded-xl
                                    border

                                    ${
                                        feedback.type ===
                                        "success"
                                            ? "bg-emerald-50 border-emerald-200 text-emerald-700"
                                            : "bg-red-50 border-red-200 text-red-700"
                                    }
                                `}
                            >
                                {feedback.type ===
                                "success" ? (
                                    <CheckCircle2
                                        size={19}
                                        className="shrink-0 mt-0.5"
                                    />
                                ) : (
                                    <AlertCircle
                                        size={19}
                                        className="shrink-0 mt-0.5"
                                    />
                                )}

                                <div>
                                    <p className="font-semibold text-sm">
                                        {feedback.type ===
                                        "success"
                                            ? "Opération réussie"
                                            : "Erreur"}
                                    </p>

                                    <p className="text-sm mt-0.5">
                                        {feedback.text}
                                    </p>
                                </div>
                            </div>
                        </div>
                    )}

                    {/* =================================================
                        ACTIONS
                    ================================================= */}

                    <div
                        className="
                            px-5
                            md:px-6
                            py-3
                            bg-slate-50
                            border-t
                            border-slate-200
                            flex
                            flex-wrap
                            items-center
                            justify-end
                            gap-3
                        "
                    >
                        <button
                            type="button"
                            onClick={handleCancel}
                            disabled={saving}
                            className="inline-flex items-center justify-center gap-2 px-5 py-2 rounded-xl border border-slate-200 bg-white text-slate-700 text-sm font-semibold hover:bg-slate-50 hover:border-slate-300 transition disabled:opacity-60 disabled:cursor-not-allowed"
                        >
                            Annuler
                        </button>

                        <button
                        onClick={() => navigate("/admin/cabinet/liste")}

                            type="button"
                            onClick={handleSave}
                            disabled={
                                saving ||
                                !form.nom.trim()
                            }
                            className="inline-flex items-center justify-center gap-2 px-5 py-2 rounded-xl bg-blue-600 text-white text-sm font-semibold shadow-lg shadow-blue-600/20 hover:bg-blue-700 active:scale-[0.98] transition-all disabled:opacity-60 disabled:cursor-not-allowed"
                        >
                            {saving ? (
                                <Loader2
                                    size={18}
                                    className="animate-spin"
                                />
                            ) : (
                                <Save size={18} />
                            )}

                            {saving
                                ? "Enregistrement..."
                                : "Enregistrer"}
                        </button>
                    </div>
                </div>
            )}
        </div>
    );
}

// =============================================================
// MODALE DE SELECTION
// =============================================================

function SelectionModal({
    openList,
    setOpenList,

    filteredMedecins,
    filteredPatients,
    filteredSecretaires,

    selectedMedecins,
    selectedPatients,
    selectedSecretaires,

    toggleMedecin,
    togglePatient,
    toggleSecretaire,

    searchMedecin,
    setSearchMedecin,

    searchPatient,
    setSearchPatient,

    searchSecretaire,
    setSearchSecretaire,
}) {
    let config;

    if (openList === "medecins") {
        config = {
            title: "Choisir le médecin (un seul)",
            icon: Stethoscope,
            items: filteredMedecins,
            selected: selectedMedecins,
            toggle: toggleMedecin,
            search: searchMedecin,
            setSearch: setSearchMedecin,
            placeholder: "Rechercher un médecin...",
            detail: (item) =>
                item.specialite?.nom ||
                item.email ||
                "Médecin",
            color:
                "blue",
        };
    } else if (openList === "patients") {
        config = {
            title: "Choisir les patients",
            icon: Users,
            items: filteredPatients,
            selected: selectedPatients,
            toggle: togglePatient,
            search: searchPatient,
            setSearch: setSearchPatient,
            placeholder: "Rechercher un patient...",
            detail: (item) =>
                item.telephone ||
                item.email ||
                "Patient",
            color:
                "violet",
        };
    } else {
        config = {
            title: "Choisir les secrétaires",
            icon: UserRound,
            items: filteredSecretaires,
            selected: selectedSecretaires,
            toggle: toggleSecretaire,
            search: searchSecretaire,
            setSearch: setSearchSecretaire,
            placeholder: "Rechercher une secrétaire...",
            detail: (item) =>
                item.email ||
                item.telephone ||
                "Secrétaire",
            color:
                "teal",
        };
    }

    const Icon = config.icon;

    const selectedCount = config.selected.length;

    return (
        <div
            className="
                fixed
                inset-0
                z-[70]
                bg-slate-950/50
                backdrop-blur-sm
                flex
                overflow-y-auto
                p-4
            "
            onClick={() => setOpenList(null)}
        >
            <div
                className="
                    bg-white
                    rounded-2xl
                    shadow-2xl
                    w-full
                    max-w-xl
                    m-auto
                    flex
                    flex-col
                    overflow-hidden
                "
                onClick={(e) =>
                    e.stopPropagation()
                }
            >

                {/* HEADER */}

                <div
                    className="
                        flex
                        items-center
                        gap-3
                        px-5
                        py-4
                        border-b
                        border-slate-100
                    "
                >
                    <div
                        className="
                            w-10
                            h-10
                            rounded-xl
                            bg-blue-50
                            flex
                            items-center
                            justify-center
                        "
                    >
                        <Icon
                            size={19}
                            className="text-blue-600"
                        />
                    </div>

                    <div className="flex-1">

                        <h3
                            className="
                                font-bold
                                text-slate-900
                            "
                        >
                            {config.title}
                        </h3>

                        <p
                            className="
                                text-xs
                                text-slate-400
                                mt-0.5
                            "
                        >
                            Sélection multiple
                        </p>
                    </div>

                    <button
                        type="button"
                        onClick={() =>
                            setOpenList(null)
                        }
                        className="
                            p-2
                            rounded-lg
                            text-slate-400
                            hover:bg-slate-100
                            hover:text-slate-700
                        "
                    >
                        <X size={18} />
                    </button>
                </div>

                {/* RECHERCHE */}

                <div className="px-5 py-4">

                    <div className="relative">

                        <Search
                            size={16}
                            className="
                                absolute
                                left-3.5
                                top-1/2
                                -translate-y-1/2
                                text-slate-400
                            "
                        />

                        <input
                            type="text"
                            value={config.search}
                            onChange={(e) =>
                                config.setSearch(
                                    e.target.value
                                )
                            }
                            placeholder={
                                config.placeholder
                            }
                            className="
                                w-full
                                pl-10
                                pr-4
                                py-2.5
                                rounded-xl
                                border
                                border-slate-200
                                text-sm
                                outline-none
                                focus:ring-2
                                focus:ring-blue-500
                            "
                            autoFocus
                        />
                    </div>
                </div>

                {/* LISTE */}

                <div
                    className="
                        px-5
                        pb-5
                        space-y-2
                    "
                >
                    {config.items.length === 0 ? (
                        <div
                            className="
                                text-center
                                py-12
                            "
                        >
                            <Users
                                size={30}
                                className="
                                    mx-auto
                                    text-slate-300
                                    mb-3
                                "
                            />

                            <p
                                className="
                                    text-sm
                                    text-slate-400
                                "
                            >
                                Aucun élément trouvé.
                            </p>
                        </div>
                    ) : (
                        config.items.map((item) => {
                            const id = Number(
                                item.id
                            );

                            const checked =
                                config.selected.includes(
                                    id
                                );

                            return (
                                <button
                                    key={item.id}
                                    type="button"
                                    onClick={() =>
                                        config.toggle(
                                            item.id
                                        )
                                    }
                                    className={`
                                        w-full
                                        flex
                                        items-center
                                        gap-3
                                        px-4
                                        py-3
                                        rounded-xl
                                        border
                                        text-left
                                        transition

                                        ${
                                            checked
                                                ? "border-blue-200 bg-blue-50"
                                                : "border-slate-100 bg-white hover:bg-slate-50"
                                        }
                                    `}
                                >

                                    {/* CHECKBOX */}

                                    <span
                                        className={`
                                            w-5
                                            h-5
                                            rounded-md
                                            border-2
                                            flex
                                            items-center
                                            justify-center
                                            shrink-0

                                            ${
                                                checked
                                                    ? "bg-blue-600 border-blue-600 text-white"
                                                    : "border-slate-300 bg-white"
                                            }
                                        `}
                                    >
                                        {checked && (
                                            <CheckCircle2
                                                size={13}
                                            />
                                        )}
                                    </span>

                                    {/* AVATAR */}

                                    <span
                                        className="
                                            w-9
                                            h-9
                                            rounded-full
                                            bg-slate-100
                                            flex
                                            items-center
                                            justify-center
                                            text-slate-500
                                            shrink-0
                                        "
                                    >
                                        {config.color ===
                                        "blue" ? (
                                            <Stethoscope
                                                size={16}
                                            />
                                        ) : config.color ===
                                          "teal" ? (
                                            <UserRound
                                                size={16}
                                            />
                                        ) : (
                                            <Users
                                                size={16}
                                            />
                                        )}
                                    </span>

                                    {/* NOM */}

                                    <span className="flex-1 min-w-0">

                                        <span
                                            className="
                                                block
                                                font-semibold
                                                text-sm
                                                text-slate-800
                                            "
                                        >
                                            {item.prenom ||
                                                ""}{" "}
                                            {item.nom ||
                                                ""}
                                        </span>

                                        <span
                                            className="
                                                block
                                                text-xs
                                                text-slate-400
                                                mt-0.5
                                                truncate
                                            "
                                        >
                                            {config.detail(
                                                item
                                            )}
                                        </span>
                                    </span>

                                    {/* SELECTION */}

                                    {checked && (
                                        <span
                                            className="
                                                text-xs
                                                font-bold
                                                text-blue-600
                                            "
                                        >
                                            Sélectionné
                                        </span>
                                    )}
                                </button>
                            );
                        })
                    )}
                </div>

                {/* FOOTER */}

                <div
                    className="
                        flex
                        items-center
                        justify-between
                        gap-3
                        px-5
                        py-4
                        bg-slate-50
                        border-t
                        border-slate-100
                    "
                >
                    <span
                        className="
                            text-sm
                            font-semibold
                            text-slate-600
                        "
                    >
                        {selectedCount} sélectionné(s)
                    </span>

                    <button
                        type="button"
                        onClick={() =>
                            setOpenList(null)
                        }
                        className="
                            px-5
                            py-2.5
                            rounded-xl
                            bg-blue-600
                            text-white
                            text-sm
                            font-semibold
                            hover:bg-blue-700
                            shadow-sm
                        "
                    >
                        Terminer
                    </button>
                </div>
            </div>
        </div>
    );
}

export default Cabinet;