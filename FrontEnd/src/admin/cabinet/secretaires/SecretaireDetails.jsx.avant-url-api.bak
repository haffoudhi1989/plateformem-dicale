import React, { useEffect, useState } from "react";
import { useParams, Link } from "react-router-dom";

import {
    ArrowLeft,
    UserRoundCog,
    Mail,
    Phone,
    Building2,
    ShieldCheck,
    Loader2
} from "lucide-react";

function SecretaireDetails() {

    const { id } = useParams();

    const [secretaire, setSecretaire] = useState(null);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState("");

    const API_URL =
        import.meta.env.VITE_API_URL ||
        "http://127.0.0.1:8000/api";

    // =====================================================
    // CHARGER LA SECRETAIRE
    // =====================================================

    useEffect(() => {

        const fetchSecretaire = async () => {

            try {

                setLoading(true);
                setError("");

                const response = await fetch(
                    `${API_URL}/secretaires/${id}`,
                    {
                        headers: {
                            Accept: "application/json", Authorization: `Bearer ${localStorage.getItem("token") || sessionStorage.getItem("token")}`
                        }
                    }
                );

                const result = await response.json();

                if (!response.ok || !result.success) {

                    throw new Error(
                        result.message ||
                        "Impossible de récupérer cette secrétaire."
                    );
                }

                setSecretaire(result.data);

            } catch (err) {

                console.error(
                    "Erreur chargement secrétaire :",
                    err
                );

                setError(
                    err.message ||
                    "Impossible de charger cette secrétaire."
                );

            } finally {

                setLoading(false);

            }
        };

        if (id) {
            fetchSecretaire();
        }

    }, [id]);


    // =====================================================
    // CHARGEMENT
    // =====================================================

    if (loading) {

        return (
            <div className="min-h-screen bg-slate-50">

                <div className="w-full">

                    <div className="
                        bg-white
                        rounded-2xl
                        border
                        border-slate-200
                        shadow-sm
                        p-10
                        flex
                        items-center
                        justify-center
                        gap-3
                        text-slate-500
                    ">

                        <Loader2
                            size={22}
                            className="animate-spin"
                        />

                        Chargement de la secrétaire...

                    </div>

                </div>

            </div>
        );
    }


    // =====================================================
    // ERREUR
    // =====================================================

    if (error || !secretaire) {

        return (
            <div className="min-h-screen bg-slate-50">

                <div className="w-full">

                    <Link
                        to="/admin/cabinet/secretaires"
                        className="
                            inline-flex
                            items-center
                            gap-2
                            text-sm
                            text-slate-600
                            hover:text-blue-700
                            mb-6
                        "
                    >
                        <ArrowLeft size={18} />
                        Retour aux secrétaires
                    </Link>

                    <div className="
                        bg-white
                        rounded-2xl
                        border
                        border-red-200
                        shadow-sm
                        p-8
                    ">

                        <div className="flex items-center gap-3">

                            <div className="
                                w-12
                                h-12
                                rounded-xl
                                bg-red-100
                                text-red-600
                                flex
                                items-center
                                justify-center
                            ">
                                <UserRoundCog size={24} />
                            </div>

                            <div>

                                <h1 className="
                                    text-xl
                                    font-bold
                                    text-slate-900
                                ">
                                    Secrétaire introuvable
                                </h1>

                                <p className="
                                    text-sm
                                    text-slate-500
                                    mt-1
                                ">
                                    Impossible de trouver la secrétaire #{id}.
                                </p>

                            </div>

                        </div>

                        {error && (
                            <p className="
                                mt-5
                                text-sm
                                text-red-600
                            ">
                                {error}
                            </p>
                        )}

                    </div>

                </div>

            </div>
        );
    }


    // =====================================================
    // STATUT
    // =====================================================

    const actif =
        secretaire.actif === true ||
        secretaire.actif === 1;


    // =====================================================
    // RENDER
    // =====================================================

    return (

            <div className="min-h-screen bg-slate-50">

            <div className="max-w-5xl mx-auto">

                {/* BANNIÈRE */}
                <div className="rounded-2xl bg-gradient-to-r from-[#26415E] to-[#3A5570] shadow-lg shadow-blue-200/60 p-4 md:p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-3 min-h-[88px] md:min-h-[96px] mb-4">
                    <div className="flex items-center gap-4">
                        <div className="w-14 h-14 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center shrink-0">
                            <UserRoundCog size={26} className="text-white" />
                        </div>
                        <div>
                            <h1 className="text-lg md:text-xl font-bold text-white mt-0.5">
                                {secretaire.prenom} {secretaire.nom}
                            </h1>
                            <p className="text-blue-100 text-sm mt-0.5">
                                Secrétaire #{secretaire.id}
                            </p>
                        </div>
                    </div>
                    <div className="flex flex-wrap items-center gap-2.5">
                        <Link
                            to="/admin/cabinet/secretaires"
                            className="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white text-xs font-semibold transition"
                        >
                            <ArrowLeft size={18} />
                            Retour aux secrétaires
                        </Link>


                        <span
                            className={`
                                inline-flex
                                items-center
                                px-3
                                py-1.5
                                rounded-full
                                text-xs
                                font-semibold
                                ${
                                    actif
                                        ? "bg-emerald-50 text-emerald-700 border border-emerald-200"
                                        : "bg-red-50 text-red-700 border border-red-200"
                                }
                            `}
                        >
                            {actif ? "Actif" : "Inactif"}
                        </span>
                    </div>
                </div>


                {/* CARTE PRINCIPALE */}

                <div className="
                    bg-white
                    rounded-2xl
                    border
                    border-slate-200
                    shadow-sm
                    p-6
                ">

                    {/* INFORMATIONS */}

                    <div className="
                        grid
                        grid-cols-1
                        md:grid-cols-2
                        gap-5
                        mt-8
                    ">

                        <Info
                            icon={<Mail size={18} />}
                            label="Email"
                            value={secretaire.email || "-"}
                        />

                        <Info
                            icon={<Phone size={18} />}
                            label="Téléphone"
                            value={secretaire.telephone || "-"}
                        />

                        <Info
                            icon={<Building2 size={18} />}
                            label="Cabinet"
                            value={
                                secretaire.cabinet?.nom ||
                                secretaire.cabinet?.name ||
                                "Aucun cabinet"
                            }
                        />

                        <Info
                            icon={<UserRoundCog size={18} />}
                            label="Identifiant"
                            value={`#${secretaire.id}`}
                        />

                    </div>


                    {/* PERMISSIONS */}

                    <div className="
                        mt-6
                        p-5
                        rounded-2xl
                        bg-blue-50
                        border
                        border-blue-100
                    ">

                        <div className="
                            flex
                            items-center
                            gap-3
                        ">

                            <ShieldCheck
                                size={21}
                                className="text-blue-700"
                            />

                            <div>

                                <h2 className="
                                    font-bold
                                    text-slate-900
                                ">
                                    Permissions
                                </h2>

                                <p className="
                                    text-sm
                                    text-slate-500
                                    mt-1
                                ">
                                    Permissions actuellement attribuées à cette secrétaire.
                                </p>

                            </div>

                        </div>


                        <div className="
                            flex
                            flex-wrap
                            gap-2
                            mt-4
                        ">

                            <span className="
                                px-3
                                py-1.5
                                rounded-full
                                bg-white
                                text-blue-700
                                text-xs
                                font-semibold
                            ">
                                Agenda
                            </span>

                            <span className="
                                px-3
                                py-1.5
                                rounded-full
                                bg-white
                                text-blue-700
                                text-xs
                                font-semibold
                            ">
                                Rendez-vous
                            </span>

                            <span className="
                                px-3
                                py-1.5
                                rounded-full
                                bg-white
                                text-blue-700
                                text-xs
                                font-semibold
                            ">
                                Patients
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    );
}


// =====================================================
// COMPOSANT INFO
// =====================================================

function Info({
    icon,
    label,
    value
}) {

    return (

        <div className="
            p-4
            rounded-xl
            border
            border-slate-200
            bg-slate-50
        ">

            <div className="
                flex
                items-center
                gap-3
            ">

                <div className="
                    w-9
                    h-9
                    rounded-lg
                    bg-white
                    text-blue-700
                    flex
                    items-center
                    justify-center
                ">
                    {icon}
                </div>

                <div>

                    <p className="
                        text-xs
                        text-slate-500
                    ">
                        {label}
                    </p>

                    <p className="
                        text-sm
                        font-semibold
                        text-slate-800
                        mt-1
                    ">
                        {value}
                    </p>

                </div>

            </div>

        </div>
    );
}

export default SecretaireDetails;