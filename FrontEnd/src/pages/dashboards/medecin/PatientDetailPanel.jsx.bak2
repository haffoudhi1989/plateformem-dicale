import { useState } from "react";
import { FolderOpen, History, X, Loader2, Plus, FilePlus2, FlaskConical } from "lucide-react";

const fmtDate = (d) => {
    if (!d) return "-";
    const dt = new Date(d);
    return `${dt.getDate()}/${dt.getMonth() + 1}/${dt.getFullYear()}`;
};

const modeLabel = (m) => {
    const map = {
        presentiel: "Présentiel",
        video: "Téléconsultation",
        telephone: "Téléphone",
        en_ligne: "En ligne",
    };
    return map[m] || m || "";
};

const sexeLabel = (sexe) => {
    if (!sexe) return "Non renseigné";
    if (sexe === "M") return "Homme";
    if (sexe === "F") return "Femme";
    return sexe;
};

const valeurOuNonRenseigne = (valeur) => {
    if (valeur === null || valeur === undefined) return "Non renseigné";
    const texte = String(valeur).trim();
    return texte === "" ? "Non renseigné" : texte;
};

const statutLabel = (statut) => {
    const texte = String(statut || "Planifié").replace(/_/g, " ");
    return texte.charAt(0).toUpperCase() + texte.slice(1);
};

const dateHeureLabel = (date, heure) => {
    const jour = date ? fmtDate(date) : "Non renseigné";
    return heure ? `${jour} à ${String(heure).substring(0, 5)}` : jour;
};

export default function PatientDetailPanel({
    patient,
    tab,
    setTab,
    loading,
    error,
    ordonnances = [],
    analyses = [],
    rdvs = [],
    onClose,
    onAjouterOrdonnance,
    onAjouterAnalyse,
    onVoirOrdonnances,
    onVoirAnalyses,
}) {
    const [menuOuvert, setMenuOuvert] = useState(false);

    if (!patient) return null;

    const identite = `${patient.prenom ?? ""} ${patient.nom ?? ""}`;

    const dernieresConsultations = [...rdvs]
        .sort((a, b) => {
            const cleA = `${a.date_rdv || a.date || ""} ${a.heure_rdv || a.heure || ""}`;
            const cleB = `${b.date_rdv || b.date || ""} ${b.heure_rdv || b.heure || ""}`;
            return cleB.localeCompare(cleA);
        })
        .slice(0, 3);

    const infosPatient = [
        { label: "Nom", valeur: patient.nom },
        { label: "Prénom", valeur: patient.prenom },
        { label: "Référence dossier", valeur: patient.reference },
        { label: "Téléphone", valeur: patient.telephone },
        { label: "Email", valeur: patient.email },
        {
            label: "Date de naissance",
            valeur: patient.date_naissance ? fmtDate(patient.date_naissance) : "",
        },
        { label: "Sexe", valeur: patient.sexe ? sexeLabel(patient.sexe) : "" },
        { label: "Groupe sanguin", valeur: patient.groupe_sanguin },
        { label: "Allergies", valeur: patient.allergies },
    ];

    return (
        <div className="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden">
            <div className="p-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
                <div className="flex items-center gap-3">
                    <div className="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-sm font-bold text-emerald-700">
                        {(patient.prenom?.charAt(0) || "") + (patient.nom?.charAt(0) || "")}
                    </div>
                    <div>
                        <p className="font-semibold text-slate-800">{identite}</p>
                        <p className="text-xs text-slate-400">
                            {patient.reference ? `Dossier ${patient.reference} · ` : ""}
                            {sexeLabel(patient.sexe)}
                            {patient.telephone ? ` · ${patient.telephone}` : ""}
                        </p>
                    </div>
                </div>

                <div className="flex flex-wrap items-center gap-2">
                    <div className="relative">
                        <button
                            type="button"
                            onClick={() => setMenuOuvert((v) => !v)}
                            className="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3.5 py-2 text-xs font-bold text-white shadow-sm hover:bg-emerald-700 transition"
                            title="Ajouter une ordonnance ou une analyse"
                        >
                            <Plus size={16} /> Ajouter
                        </button>
                        {menuOuvert && (
                            <div className="absolute right-0 z-30 mt-2 w-64 rounded-xl border border-slate-200 bg-white p-1.5 shadow-xl">
                                <button
                                    type="button"
                                    onClick={() => {
                                        setMenuOuvert(false);
                                        onAjouterOrdonnance?.(patient);
                                    }}
                                    className="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-xs font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700"
                                >
                                    <FilePlus2 size={14} /> Ajouter une ordonnance
                                </button>
                                <button
                                    type="button"
                                    onClick={() => {
                                        setMenuOuvert(false);
                                        onAjouterAnalyse?.(patient);
                                    }}
                                    className="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-xs font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700"
                                >
                                    <FlaskConical size={14} /> Ajouter une analyse
                                </button>
                                <div className="my-1 border-t border-slate-100" />
                                <button
                                    type="button"
                                    onClick={() => {
                                        setMenuOuvert(false);
                                        onVoirOrdonnances?.(patient);
                                    }}
                                    className="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-xs font-semibold text-slate-600 hover:bg-slate-100"
                                >
                                    <FolderOpen size={14} /> Voir les ordonnances ({ordonnances.length})
                                </button>
                                <button
                                    type="button"
                                    onClick={() => {
                                        setMenuOuvert(false);
                                        onVoirAnalyses?.(patient);
                                    }}
                                    className="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-xs font-semibold text-slate-600 hover:bg-slate-100"
                                >
                                    <FolderOpen size={14} /> Voir les analyses ({analyses.length})
                                </button>
                            </div>
                        )}
                    </div>
                    <button
                        type="button"
                        onClick={() => setTab("fiche")}
                        className={`inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs font-semibold transition ${
                            tab === "fiche"
                                ? "bg-emerald-600 text-white"
                                : "bg-slate-100 text-slate-600 hover:bg-slate-200"
                        }`}
                    >
                        Fiche patient
                    </button>
                    <button
                        type="button"
                        onClick={() => setTab("dossier")}
                        className={`inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs font-semibold transition ${
                            tab === "dossier"
                                ? "bg-emerald-600 text-white"
                                : "bg-slate-100 text-slate-600 hover:bg-slate-200"
                        }`}
                    >
                        <FolderOpen size={14} /> Dossier medical
                    </button>
                    <button
                        type="button"
                        onClick={() => setTab("historique")}
                        className={`inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs font-semibold transition ${
                            tab === "historique"
                                ? "bg-emerald-600 text-white"
                                : "bg-slate-100 text-slate-600 hover:bg-slate-200"
                        }`}
                    >
                        <History size={14} /> Historique consultations
                    </button>
                    <button
                        type="button"
                        onClick={onClose}
                        className="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600"
                        title="Fermer"
                    >
                        <X size={16} />
                    </button>
                </div>
            </div>

            <div className="p-5">
                {error && (
                    <div className="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-700">
                        {error}
                    </div>
                )}

                {loading ? (
                    <div className="flex items-center justify-center py-12">
                        <Loader2 size={22} className="animate-spin text-emerald-600" />
                    </div>
                ) : tab === "fiche" ? (
                    <div className="space-y-6">
                        <div>
                            <h3 className="text-sm font-semibold text-slate-700 mb-3">
                                Informations patient
                            </h3>
                            <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
                                {infosPatient.map((info) => (
                                    <div
                                        key={info.label}
                                        className="rounded-xl border border-slate-200 bg-slate-50/60 p-3"
                                    >
                                        <p className="text-[11px] font-semibold uppercase tracking-wide text-slate-400">
                                            {info.label}
                                        </p>
                                        <p className="text-sm text-slate-800 mt-1 break-words">
                                            {valeurOuNonRenseigne(info.valeur)}
                                        </p>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <div className="rounded-xl border border-dashed border-emerald-300 bg-emerald-50/50 p-4 flex flex-wrap items-center justify-between gap-3">
                            <p className="text-xs font-medium text-emerald-900">
                                Ordonnances : {ordonnances.length} · Analyses : {analyses.length}
                            </p>
                            <div className="flex flex-wrap items-center gap-2">
                                <button
                                    type="button"
                                    onClick={() => onAjouterOrdonnance?.(patient)}
                                    className="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white hover:bg-emerald-700"
                                >
                                    <FilePlus2 size={14} /> Ajouter une ordonnance
                                </button>
                                <button
                                    type="button"
                                    onClick={() => onAjouterAnalyse?.(patient)}
                                    className="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white hover:bg-emerald-700"
                                >
                                    <FlaskConical size={14} /> Ajouter une analyse
                                </button>
                                <button
                                    type="button"
                                    onClick={() => onVoirOrdonnances?.(patient)}
                                    className="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100"
                                >
                                    <FolderOpen size={14} /> Voir les ordonnances
                                </button>
                                <button
                                    type="button"
                                    onClick={() => onVoirAnalyses?.(patient)}
                                    className="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100"
                                >
                                    <FolderOpen size={14} /> Voir les analyses
                                </button>
                            </div>
                        </div>

                        <div>
                            <div className="flex items-center justify-between mb-3">
                                <h3 className="text-sm font-bold text-slate-800">
                                    3 dernières consultations
                                </h3>
                                {rdvs.length > 3 && (
                                    <button
                                        type="button"
                                        onClick={() => setTab("historique")}
                                        className="text-xs font-semibold text-emerald-700 hover:underline"
                                    >
                                        Voir tout l'historique ({rdvs.length})
                                    </button>
                                )}
                            </div>
                            {dernieresConsultations.length === 0 ? (
                                <p className="text-sm text-slate-400">
                                    Aucune consultation enregistrée pour ce patient.
                                </p>
                            ) : (
                                <div className="space-y-3">
                                    {dernieresConsultations.map((r, index) => (
                                        <div
                                            key={r.id ?? index}
                                            className="rounded-xl border border-slate-200 p-4 flex flex-wrap items-start justify-between gap-2"
                                        >
                                            <div className="min-w-0">
                                                <p className="text-sm font-semibold text-slate-800">
                                                    {dateHeureLabel(
                                                        r.date_rdv || r.date,
                                                        r.heure_rdv || r.heure
                                                    )}
                                                </p>
                                                {r.medecin && (
                                                    <p className="text-xs font-medium text-emerald-700 mt-0.5">
                                                        Dr {r.medecin.prenom || ""}{" "}
                                                        {r.medecin.nom || ""}
                                                    </p>
                                                )}
                                                <p className="text-xs text-slate-500 mt-1">
                                                    Motif : {valeurOuNonRenseigne(r.motif)}
                                                </p>
                                            </div>
                                            <span
                                                className={`shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold ${
                                                    String(r.statut || "").includes("termin")
                                                        ? "bg-emerald-50 text-emerald-700"
                                                        : String(r.statut || "").includes("annul")
                                                        ? "bg-red-50 text-red-700"
                                                        : "bg-slate-100 text-slate-600"
                                                }`}
                                            >
                                                {statutLabel(r.statut)}
                                            </span>
                                        </div>
                                    ))}
                                </div>
                            )}
                        </div>
                    </div>
                ) : tab === "dossier" ? (
                    <div className="grid lg:grid-cols-2 gap-5">
                        <div>
                            <h3 className="text-sm font-semibold text-slate-700 mb-3">
                                Ordonnances ({ordonnances.length})
                            </h3>
                            {ordonnances.length === 0 ? (
                                <p className="text-sm text-slate-400">
                                    Aucune ordonnance enregistree.
                                </p>
                            ) : (
                                <div className="space-y-3">
                                    {ordonnances.map((o) => (
                                        <div
                                            key={o.id}
                                            className="rounded-xl border border-slate-200 p-4"
                                        >
                                            <div className="flex items-center justify-between mb-1">
                                                <span className="text-sm font-semibold text-slate-800">
                                                    Ordonnance #{o.id}
                                                </span>
                                                <span className="text-xs text-slate-400">
                                                    {fmtDate(o.date_ordonnance)}
                                                </span>
                                            </div>
                                            {o.notes && (
                                                <p className="text-xs text-slate-500 mb-2">
                                                    {o.notes}
                                                </p>
                                            )}
                                            <div className="flex flex-wrap gap-1.5">
                                                {(o.lignes || o.medicaments || []).map((m, i) => (
                                                    <span
                                                        key={i}
                                                        className="rounded-full bg-emerald-50 text-emerald-700 px-2.5 py-1 text-xs"
                                                    >
                                                        {m.medicament || m.nom || m}
                                                        {m.dosage ? ` - ${m.dosage}` : ""}
                                                    </span>
                                                ))}
                                                {(o.lignes || []).length === 0 &&
                                                    (o.medicaments || []).length === 0 && (
                                                        <span className="rounded-full bg-slate-100 text-slate-500 px-2.5 py-1 text-xs">
                                                            {o.statut === "active"
                                                                ? "Active"
                                                                : o.statut || "Enregistree"}
                                                        </span>
                                                    )}
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            )}
                        </div>
                        <div>
                            <h3 className="text-sm font-semibold text-slate-700 mb-3">
                                Analyses ({analyses.length})
                            </h3>
                            {analyses.length === 0 ? (
                                <p className="text-sm text-slate-400">
                                    Aucune analyse enregistree.
                                </p>
                            ) : (
                                <div className="space-y-3">
                                    {analyses.map((a) => (
                                        <div
                                            key={a.id}
                                            className="rounded-xl border border-slate-200 p-4"
                                        >
                                            <div className="flex items-center justify-between mb-1">
                                                <span className="text-sm font-semibold text-slate-800">
                                                    {a.nom || a.type || `Analyse #${a.id}`}
                                                </span>
                                                <span className="text-xs text-slate-400">
                                                    {fmtDate(a.date_examen)}
                                                </span>
                                            </div>
                                            <span className="inline-block rounded-full bg-sky-50 text-sky-700 px-2.5 py-1 text-xs">
                                                {a.statut || "En attente"}
                                            </span>
                                            {a.resultat && (
                                                <p className="text-xs text-slate-500 mt-2">
                                                    {a.resultat}
                                                </p>
                                            )}
                                        </div>
                                    ))}
                                </div>
                            )}
                        </div>
                    </div>
                ) : (
                    <div>
                        <h3 className="text-sm font-semibold text-slate-700 mb-3">
                            Historique des consultations ({rdvs.length})
                        </h3>
                        {rdvs.length === 0 ? (
                            <p className="text-sm text-slate-400">
                                Aucune consultation enregistree pour ce patient.
                            </p>
                        ) : (
                            <div className="space-y-3">
                                {rdvs.map((r) => (
                                    <div
                                        key={r.id}
                                        className="rounded-xl border border-slate-200 p-4"
                                    >
                                        <div className="flex flex-wrap items-start justify-between gap-2">
                                            <div className="min-w-0">
                                                <p className="text-sm font-semibold text-slate-800">
                                                    {fmtDate(r.date_rdv || r.date)}
                                                    {r.heure_rdv || r.heure
                                                        ? ` a ${r.heure_rdv || r.heure}`
                                                        : ""}
                                                </p>
                                                {r.medecin && (
                                                    <p className="text-xs font-medium text-emerald-700 mt-0.5">
                                                        Dr{" "}
                                                        {r.medecin.prenom || ""}{" "}
                                                        {r.medecin.nom || ""}
                                                    </p>
                                                )}
                                                {r.motif && (
                                                    <p className="text-xs text-slate-500 mt-0.5">
                                                        Motif : {r.motif}
                                                    </p>
                                                )}
                                                {r.mode && (
                                                    <span className="inline-block mt-1.5 rounded-full bg-sky-50 text-sky-700 border border-sky-200 px-2.5 py-0.5 text-[11px] font-semibold">
                                                        {modeLabel(r.mode)}
                                                    </span>
                                                )}
                                                {r.notes && (
                                                    <p className="text-xs text-slate-500 mt-2 bg-slate-50 border border-slate-100 rounded-lg p-2">
                                                        {r.notes}
                                                    </p>
                                                )}
                                            </div>
                                            <span
                                                className={`shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold ${
                                                    String(r.statut || "").includes("termin")
                                                        ? "bg-emerald-50 text-emerald-700"
                                                        : String(r.statut || "").includes("annul")
                                                        ? "bg-red-50 text-red-700"
                                                        : "bg-slate-100 text-slate-600"
                                                }`}
                                            >
                                                {(r.statut || "Planifie").replace(
                                                    "_",
                                                    " "
                                                )}
                                            </span>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        )}
                    </div>
                )}
            </div>
        </div>
    );
}
