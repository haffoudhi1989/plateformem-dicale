import React, { useEffect, useState } from "react";
import axios from "axios";
import { useNavigate } from "react-router-dom";
import { Users, CalendarDays, ArrowLeft, Phone, Mail, UserX, FolderOpen, History } from "lucide-react";
import PatientDetailPanel from "./PatientDetailPanel";

const API_URL = "http://127.0.0.1:8000/api";

export default function MedecinPatients() {
    const navigate = useNavigate();

    const [medecin, setMedecin] = useState(null);
    const [patients, setPatients] = useState([]);
    const [rendezVousCount, setRendezVousCount] = useState(0);
    const [loading, setLoading] = useState(true);

    const [selectedPatient, setSelectedPatient] = useState(null);
    const [detailTab, setDetailTab] = useState("dossier");
    const [detailLoading, setDetailLoading] = useState(false);
    const [detailError, setDetailError] = useState("");
    const [detailOrdonnances, setDetailOrdonnances] = useState([]);
    const [detailAnalyses, setDetailAnalyses] = useState([]);
    const [detailRdvs, setDetailRdvs] = useState([]);

    useEffect(() => {
        chargerPatients();
    }, []);

    const chargerPatients = async () => {
        try {
            const token = localStorage.getItem("token");

            if (!token) {
                navigate("/login");
                return;
            }

            const response = await axios.get(
                `${API_URL}/medecin/dashboard`,
                {
                    headers: {
                        Authorization: `Bearer ${token}`,
                        Accept: "application/json",
                    },
                }
            );

            setMedecin(response.data.medecin);
            setPatients(response.data.patients || []);
            setRendezVousCount(response.data.rendez_vous?.length || 0);

        } catch (error) {
            console.error(error);
            if (error.response?.status === 401) {
                localStorage.removeItem("token");
                localStorage.removeItem("user");
                navigate("/login");
            }
        } finally {
            setLoading(false);
        }
    };

    const tokenHeaders = () => {
        const t = localStorage.getItem("token");
        return {
            Accept: "application/json",
            Authorization: `Bearer ${t}`,
        };
    };

    const chargerDossier = async (patient) => {
        setSelectedPatient(patient);
        setDetailTab("dossier");
        setDetailLoading(true);
        setDetailError("");

        try {
            const [resOrdo, resAnalyses] = await Promise.all([
                axios.get(
                    `${API_URL}/patients/${patient.id}/ordonnances`,
                    { headers: tokenHeaders() }
                ),
                axios.get(`${API_URL}/analyses`, {
                    headers: tokenHeaders(),
                }),
            ]);

            const ordo = Array.isArray(resOrdo.data)
                ? resOrdo.data
                : (resOrdo.data?.ordonnances ??
                  resOrdo.data?.data ??
                  []);
            const analyses = Array.isArray(resAnalyses.data)
                ? resAnalyses.data
                : resAnalyses.data?.data ?? [];

            setDetailOrdonnances(Array.isArray(ordo) ? ordo : []);
            setDetailAnalyses(
                analyses.filter((a) => a.patient_id === patient.id)
            );
        } catch (err) {
            setDetailError(
                err.response?.data?.message ||
                    "Impossible de charger le dossier."
            );
        } finally {
            setDetailLoading(false);
        }
    };

    const chargerHistorique = async (patient) => {
        setSelectedPatient(patient);
        setDetailTab("historique");
        setDetailLoading(true);
        setDetailError("");

        try {
            const res = await axios.get(
                `${API_URL}/medecin/dashboard`,
                { headers: tokenHeaders() }
            );

            const rdvs = Array.isArray(res.data?.rendez_vous)
                ? res.data.rendez_vous
                : res.data?.data?.rendez_vous ?? [];

            const historique = rdvs
                .filter(
                    (r) =>
                        Number(r.patient_id ?? r.patient?.id) ===
                        Number(patient.id)
                )
                .sort((a, b) =>
                    String(b.date_rdv || b.date || "").localeCompare(
                        String(a.date_rdv || a.date || "")
                    )
                );

            setDetailRdvs(historique);
        } catch (err) {
            setDetailError(
                err.response?.data?.message ||
                    "Impossible de charger l'historique."
            );
        } finally {
            setDetailLoading(false);
        }
    };

    const changerOngletDetail = (onglet) => {
        if (!selectedPatient) return;

        if (onglet === "historique" && detailRdvs.length === 0) {
            chargerHistorique(selectedPatient);
            return;
        }

        if (
            onglet === "dossier" &&
            detailOrdonnances.length === 0 &&
            detailAnalyses.length === 0
        ) {
            chargerDossier(selectedPatient);
            return;
        }

        setDetailTab(onglet);
    };

    const fermerDetail = () => {
        setSelectedPatient(null);
        setDetailRdvs([]);
    };

    if (loading) {
        return (
            <div className="min-h-screen flex items-center justify-center bg-slate-50">
                <div className="text-center">
                    <div className="w-10 h-10 border-[3px] border-sky-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                    <p className="text-sm text-slate-500">Chargement de vos patients...</p>
                </div>
            </div>
        );
    }

    const initiales = (patient) =>
        `${patient.prenom?.charAt(0) || ""}${patient.nom?.charAt(0) || ""}`.toUpperCase() || "P";

    return (
        <div className="bg-slate-50">
            <div className="p-6 lg:p-8 space-y-6 max-w-7xl mx-auto">
                {/* En-tête */}
                <div className="rounded-3xl bg-gradient-to-r from-[#14532D] to-[#059669] shadow-lg p-6 md:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h1 className="text-2xl font-bold text-white">Mes patients</h1>
                        <p className="text-blue-100/80 text-sm mt-1">
                            Dr. {medecin?.prenom} {medecin?.nom}
                            {medecin?.specialite?.nom && (
                                <>
                                    <span className="mx-2 text-slate-300">•</span>
                                    {medecin.specialite.nom}
                                </>
                            )}
                        </p>
                    </div>
                    <button
                        onClick={() => navigate("/medecin/dashboard")}
                        className="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition"
                    >
                        <ArrowLeft className="w-4 h-4" />
                        Dashboard
                    </button>
                </div>

                {/* Statistiques */}
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                    <div className="flex items-center gap-4 bg-white rounded-2xl border border-slate-200 p-5">
                        <div className="w-11 h-11 rounded-xl bg-emerald-50 flex items-center justify-center">
                            <Users className="w-5 h-5 text-emerald-600" />
                        </div>
                        <div>
                            <p className="text-2xl font-bold text-slate-900">{patients.length}</p>
                            <p className="text-xs text-slate-500 mt-0.5">Patients suivis</p>
                        </div>
                    </div>
                    <div className="flex items-center gap-4 bg-white rounded-2xl border border-slate-200 p-5">
                        <div className="w-11 h-11 rounded-xl bg-sky-50 flex items-center justify-center">
                            <CalendarDays className="w-5 h-5 text-sky-600" />
                        </div>
                        <div>
                            <p className="text-2xl font-bold text-slate-900">{rendezVousCount}</p>
                            <p className="text-xs text-slate-500 mt-0.5">Rendez-vous</p>
                        </div>
                    </div>
                </div>

                {/* Dossier medical / Historique consultations */}
                {selectedPatient && (
                    <PatientDetailPanel
                        patient={selectedPatient}
                        tab={detailTab}
                        setTab={changerOngletDetail}
                        loading={detailLoading}
                        error={detailError}
                        ordonnances={detailOrdonnances}
                        analyses={detailAnalyses}
                        rdvs={detailRdvs}
                        onClose={fermerDetail}
                    />
                )}

                {/* Liste des patients */}
                {patients.length === 0 ? (
                    <div className="bg-white rounded-2xl border border-slate-200 py-16 px-6 text-center">
                        <div className="w-14 h-14 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-5">
                            <UserX className="w-6 h-6 text-slate-400" />
                        </div>
                        <h2 className="text-lg font-semibold text-slate-800">Aucun patient</h2>
                        <p className="text-sm text-slate-500 mt-1.5">
                            Vous n'avez aucun patient pour le moment.
                        </p>
                    </div>
                ) : (
                    <div className="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                        <div className="overflow-x-auto">
                            <table className="w-full">
                                <thead>
                                    <tr className="bg-slate-50 border-b border-slate-100">
                                        <th className="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                            Patient
                                        </th>
                                        <th className="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                            Téléphone
                                        </th>
                                        <th className="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                            Email
                                        </th>
                                        <th className="px-6 py-3.5 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">
                                            Actions
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {patients.map((patient) => (
                                        <tr
                                            key={patient.id}
                                            className="border-t border-slate-100 first:border-t-0 hover:bg-slate-50/70 transition"
                                        >
                                            <td className="px-6 py-4">
                                                <div className="flex items-center gap-3">
                                                    <div className="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-sm font-semibold text-emerald-700">
                                                        {initiales(patient)}
                                                    </div>
                                                    <div>
                                                        <p className="font-medium text-slate-800">
                                                            {patient.prenom} {patient.nom}
                                                        </p>
                                                        {patient.sexe && (
                                                            <p className="text-xs text-slate-400 mt-0.5">
                                                                {patient.sexe === "M" ? "Homme" : patient.sexe === "F" ? "Femme" : patient.sexe}
                                                            </p>
                                                        )}
                                                    </div>
                                                </div>
                                            </td>
                                            <td className="px-6 py-4">
                                                <span className="inline-flex items-center gap-2 text-sm text-slate-600">
                                                    <Phone className="w-3.5 h-3.5 text-slate-400" />
                                                    {patient.telephone || "—"}
                                                </span>
                                            </td>
                                            <td className="px-6 py-4">
                                                <span className="inline-flex items-center gap-2 text-sm text-slate-600">
                                                    <Mail className="w-3.5 h-3.5 text-slate-400" />
                                                    {patient.email || "—"}
                                                </span>
                                            </td>
                                            <td className="px-6 py-4">
                                                <div className="flex items-center justify-end gap-2">
                                                    <button
                                                        type="button"
                                                        onClick={() =>
                                                            chargerDossier(patient)
                                                        }
                                                        className="inline-flex items-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100 transition"
                                                    >
                                                        <FolderOpen size={13} />
                                                        Dossier medical
                                                    </button>
                                                    <button
                                                        type="button"
                                                        onClick={() =>
                                                            chargerHistorique(patient)
                                                        }
                                                        className="inline-flex items-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100 transition"
                                                    >
                                                        <History size={13} />
                                                        Historique
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
}
