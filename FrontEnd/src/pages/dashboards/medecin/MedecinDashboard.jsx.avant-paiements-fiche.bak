import React, { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import axios from "axios";
import BlocageAbonnement, {
    useAbonnementCabinet,
} from "../../../components/BlocageAbonnement";
import {
    CalendarDays, Users, User, Home, LogOut,
    ChevronRight, Activity, Clock, HeartPulse, TrendingUp,
    Sparkles, ArrowUpRight, CheckCircle2, Building2, Bell, CreditCard,
    MessageCircle
} from "lucide-react";

const API_URL = "http://127.0.0.1:8000/api";

/* =====================================================
   COURBE (SVG natif avec lissage Bézier et tooltips)
===================================================== */

function AreaChart({ data, color = "#14532D", height = 230 }) {
    const [hoveredPoint, setHoveredPoint] = useState(null);
    const w = 660;
    const h = height;
    const padX = 40;
    const padTop = 24;
    const padBottom = 34;
    const max = Math.max(1, ...data.map((d) => d.total));
    const innerW = w - padX * 2;
    const innerH = h - padTop - padBottom;
    const stepX = data.length > 1 ? innerW / (data.length - 1) : 0;

    const points = data.map((d, i) => ({
        x: padX + stepX * i,
        y: padTop + innerH - (d.total / max) * innerH,
        ...d,
        index: i,
    }));

    const pathD = points.reduce((path, point, index, array) => {
        if (index === 0) return `M ${point.x},${point.y}`;
        const previous = array[index - 1];
        const controlX = (previous.x + point.x) / 2;
        return `${path} C ${controlX},${previous.y} ${controlX},${point.y} ${point.x},${point.y}`;
    }, "");

    const last = points[points.length - 1];
    const first = points[0];
    const areaD = points.length > 0
        ? `${pathD} L ${last?.x ?? padX},${padTop + innerH} L ${first?.x ?? padX},${padTop + innerH} Z`
        : "";

    const gradId = `med-area-${color.replace("#", "")}`;

    return (
        <div className="relative w-full overflow-x-auto">
            <svg viewBox={`0 0 ${w} ${h}`} className="w-full min-w-[520px] h-auto">
                <defs>
                    <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stopColor={color} stopOpacity="0.2" />
                        <stop offset="100%" stopColor={color} stopOpacity="0.01" />
                    </linearGradient>
                </defs>

                {[0, 0.5, 1].map((f, i) => {
                    const y = padTop + innerH * (1 - f);
                    return (
                        <g key={i}>
                            <line
                                x1={padX}
                                x2={w - padX}
                                y1={y}
                                y2={y}
                                stroke="#E2E8F0"
                                strokeWidth="1.5"
                                strokeDasharray={f === 0 ? "none" : "4 4"}
                            />
                            <text
                                x={padX - 10}
                                y={y + 4}
                                textAnchor="end"
                                fontSize="10.5"
                                fontWeight="600"
                                fill="#94A3B8"
                            >
                                {Math.round(max * f)}
                            </text>
                        </g>
                    );
                })}

                {areaD && <path d={areaD} fill={`url(#${gradId})`} />}
                {pathD && (
                    <path
                        d={pathD}
                        fill="none"
                        stroke={color}
                        strokeWidth="3.5"
                        strokeLinecap="round"
                        strokeLinejoin="round"
                    />
                )}

                {points.map((p) => {
                    const isHovered = hoveredPoint?.index === p.index;
                    return (
                        <g key={p.index}>
                            <circle
                                cx={p.x}
                                cy={p.y}
                                r={isHovered ? 7 : p.total > 0 ? 4.5 : 3}
                                fill="white"
                                stroke={color}
                                strokeWidth={isHovered ? 3.5 : 2.5}
                                className="cursor-pointer transition-all duration-200"
                                onMouseEnter={() => setHoveredPoint(p)}
                                onMouseLeave={() => setHoveredPoint(null)}
                            />
                            <text
                                x={p.x}
                                y={h - 10}
                                textAnchor="middle"
                                fontSize="11"
                                fontWeight="700"
                                fill={isHovered ? color : "#64748B"}
                            >
                                {p.label}
                            </text>
                        </g>
                    );
                })}
            </svg>

            {hoveredPoint && (
                <div
                    className="absolute bg-slate-900 text-white text-xs rounded-xl px-3 py-1.5 shadow-lg pointer-events-none z-10 -translate-x-1/2 -translate-y-full font-medium"
                    style={{
                        left: `${(hoveredPoint.x / w) * 100}%`,
                        top: `${(hoveredPoint.y / h) * 100}%`,
                        marginTop: "-10px",
                    }}
                >
                    <span className="text-emerald-700 font-bold">{hoveredPoint.label}</span> : {hoveredPoint.total} rendez-vous
                </div>
            )}
        </div>
    );
}

export default function MedecinDashboard() {
    const navigate = useNavigate();

    // Abonnement du cabinet : l'espace est bloqué s'il n'est plus actif
    const {
        statut: statutAbo,
        dateFin,
        bloque: cabinetBloque,
    } = useAbonnementCabinet();

    const [medecin, setMedecin] = useState(null);
    const [activeTab, setActiveTab] = useState("dashboard");

    const [stats, setStats] = useState({
        rendez_vous: 0,
        patients: 0,
    });

    const [rdvParMois, setRdvParMois] = useState([]);

    const [loading, setLoading] = useState(true);

    useEffect(() => {
        getDashboard();
    }, []);

    const getDashboard = async () => {
        try {
            const token = localStorage.getItem("token");

            if (!token) {
                navigate("/login");
                return;
            }

            const response = await axios.get(`${API_URL}/medecin/dashboard`, {
                headers: {
                    Authorization: `Bearer ${token}`,
                    Accept: "application/json",
                },
            });

            setMedecin(response.data.medecin);
            setStats({
                rendez_vous: response.data.rendez_vous?.length || 0,
                patients: response.data.patients?.length || 0,
            });
            setRdvParMois(
                (response.data.rendez_vous_par_mois || []).map((m) => ({
                    ...m,
                    label: new Date(`${m.mois}-01`).toLocaleDateString("fr-FR", { month: "short" }),
                }))
            );
        } catch (error) {
            console.error("Erreur dashboard medecin :", error);
            if (error.response?.status === 401) {
                localStorage.removeItem("token");
                localStorage.removeItem("user");
                navigate("/login");
            }
        } finally {
            setLoading(false);
        }
    };

    const logout = async () => {
        try {
            const token = localStorage.getItem("token");
            await axios.post(
                `${API_URL}/logout`,
                {},
                { headers: { Authorization: `Bearer ${token}`, Accept: "application/json" } }
            );
        } catch (error) {
            console.error(error);
        }
        localStorage.removeItem("token");
        localStorage.removeItem("user");
        navigate("/login");
    };

    if (loading) {
        return (
            <div className="min-h-screen bg-slate-50 flex items-center justify-center p-6">
                <div className="bg-white border border-slate-200 rounded-xl p-8 shadow-lg flex flex-col items-center max-w-sm text-center">
                    <div className="w-14 h-14 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center mb-4">
                        <Activity size={28} className="animate-spin" />
                    </div>
                    <h3 className="font-sans text-slate-800 text-base">Chargement de votre espace</h3>
                    <p className="text-xs text-slate-500 mt-1">Veuillez patienter quelques instants...</p>
                </div>
            </div>
        );
    }

    const menu = [
        { id: "dashboard", label: "Accueil", icon: Home, path: "/medecin/dashboard" },
        { id: "notifications", label: "Notifications", icon: Bell, path: "/medecin/notifications" },
        { id: "patients", label: "Mes patients", icon: Users, path: "/medecin/patients" },
        { id: "rendez-vous", label: "Mes rendez-vous", icon: CalendarDays, path: "/medecin/rendez-vous" },
        { id: "paiements", label: "Mes paiements", icon: CreditCard, path: "/medecin/paiements" },
        { id: "messages", label: "Messagerie", icon: MessageCircle, path: "/medecin/messages" },
        { id: "profil", label: "Mon profil", icon: User, path: "/medecin/profil" },
    ];

    const cards = [
        {
            title: "Rendez-vous",
            description: "Consulter et gérer votre planning",
            icon: CalendarDays,
            count: stats.rendez_vous,
            path: "/medecin/rendez-vous",
            iconBg: "bg-emerald-50 text-emerald-700",
            badge: "Agenda",
        },
        {
            title: "Patients",
            description: "Mes patients suivis",
            icon: Users,
            count: stats.patients,
            path: "/medecin/patients",
            iconBg: "bg-emerald-50 text-emerald-700",
            badge: "Patientèle",
        },
        {
            title: "Paiements",
            description: "Encaissements de mes consultations",
            icon: CreditCard,
            count: null,
            path: "/medecin/paiements",
            iconBg: "bg-amber-50 text-amber-700",
            badge: "Finances",
        },
    ];

    const handleMenuClick = (item) => {
        if (item.id === "dashboard") {
            setActiveTab("dashboard");
        } else {
            navigate(item.path);
        }
    };

    const today = new Date();
    const formattedDate = today.toLocaleDateString("fr-FR", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
    });

    if (cabinetBloque) {
        return (
            <div className="min-h-screen bg-slate-50">
                <BlocageAbonnement
                    statut={statutAbo}
                    dateFin={dateFin}
                    espace="medecin"
                />
            </div>
        );
    }

    return (
        <div className="min-h-screen bg-slate-50 flex">
            {/* SIDEBAR */}
            <aside className="w-72 bg-white border-r border-slate-200 min-h-screen flex flex-col shrink-0">
                {/* Logo */}
                <div className="px-6 py-6 border-b border-slate-200 flex items-center gap-3">
                    <div className="w-11 h-11 bg-[#14532D] rounded-xl flex items-center justify-center text-white">
                        <HeartPulse size={22} />
                    </div>
                    <div>
                        <span className="text-lg font-sans text-slate-800 tracking-tight block">
                            MedPlatform
                        </span>
                        <span className="text-[10px] font-semibold text-emerald-600 tracking-widest block">
                            Espace Médecin
                        </span>
                    </div>
                </div>

                {/* Navigation Links */}
                <nav className="px-3 flex-1 space-y-1 overflow-y-auto">
                    {menu.map((item) => {
                        const isActive = item.id === "dashboard" && activeTab === "dashboard";
                        const Icon = item.icon;
                        return (
                            <button
                                key={item.id}
                                onClick={() => handleMenuClick(item)}
                                className={`
                                    w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-left font-medium text-xs transition-all duration-200 group cursor-pointer
                                    ${isActive
                                        ? "bg-[#14532D] text-white shadow-md shadow-[#14532D]/20"
                                        : "text-slate-500 hover:bg-slate-100 hover:text-slate-800"
                                    }
                                `}
                            >
                                <Icon
                                    size={18}
                                    className={isActive ? "text-white" : "text-slate-400 group-hover:text-emerald-600 transition-colors"}
                                />
                                <span className="flex-1">{item.label}</span>
                                {isActive && <ChevronRight size={15} className="text-white/80" />}
                            </button>
                        );
                    })}
                </nav>

                {/* Déconnexion */}
                <div className="p-3 border-t border-slate-200">
                    <button
                        onClick={logout}
                        className="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-[#7A2E33] hover:bg-[#F8EFEF] font-medium text-xs transition-all duration-200 group cursor-pointer"
                    >
                        <LogOut size={18} className="text-[#8C444A] group-hover:text-[#7A2E33] transition-colors" />
                        <span>Déconnexion</span>
                    </button>
                </div>
            </aside>

            {/* MAIN CONTENT */}
            <main className="flex-1 p-5 md:p-8 xl:p-10 overflow-y-auto space-y-7 max-w-7xl mx-auto">
                {/* HERO BANNER */}
                <section className="rounded-2xl bg-gradient-to-r from-[#14532D] to-[#059669] shadow-sm px-5 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <div className="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/15 border border-white/20 text-emerald-50 text-xs font-semibold mb-2">
                            <Sparkles size={13} className="text-white" />
                            Tableau de bord
                        </div>
                        <h1 className="text-xl font-bold text-white">
                            Bonjour, Dr. {medecin?.prenom || ""} {medecin?.nom || ""}
                        </h1>
                        <p className="text-sm text-emerald-50/90 mt-0.5 max-w-xl leading-relaxed">
                            Consultez votre planning, gérez vos patients et suivez l'activité de votre cabinet en temps réel.
                        </p>
                    </div>

                    <div className="flex flex-wrap items-center gap-2.5">
                        <div className="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/15 border border-white/20 text-white text-xs font-semibold">
                            <Clock size={15} className="text-white" />
                            <span className="capitalize">{formattedDate}</span>
                        </div>
                    </div>
                </section>

                {/* PRINCIPE : MON CABINET */}
                <div className="rounded-2xl bg-white border border-emerald-200 shadow-sm p-5 flex flex-wrap items-center justify-between gap-3">
                    <div className="flex items-center gap-3">
                        <div className="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                            <Building2 size={20} />
                        </div>
                        <div>
                            <p className="text-sm font-semibold text-slate-800">
                                Mon cabinet —{" "}
                                {medecin?.cabinet?.nom || "Non rattaché"}
                            </p>
                            <p className="text-xs text-slate-500 mt-0.5">
                                Principe appliqué : 1 médecin (vous) ·{" "}
                                {stats.patients} patient(s) dans votre suivi
                            </p>
                        </div>
                    </div>
                    <span className="rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1 text-xs font-semibold">
                        {medecin?.cabinet
                            ? "1 médecin · plusieurs patients"
                            : "Aucun cabinet associé"}
                    </span>
                </div>

                {/* STAT CARDS */}
                <section>
                    <div className="flex items-center justify-between mb-4">
                        <div>
                            <h2 className="text-base font-sans text-slate-800 tracking-tight">
                                Vue d'ensemble
                            </h2>
                            <p className="text-xs text-slate-500 mt-0.5">
                                Indicateurs clés de votre activité
                            </p>
                        </div>
                    </div>

                    <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
                        {cards.map((card, index) => {
                            const Icon = card.icon;
                            return (
                                <button
                                    key={index}
                                    type="button"
                                    onClick={() => navigate(card.path)}
                                    className="group relative text-left bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 hover:border-[#DCE8E4] transition-all duration-300 overflow-hidden cursor-pointer w-full"
                                >
                                    <div className="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-[#14532D]/5 opacity-0 group-hover:opacity-100 blur-2xl transition-opacity duration-300 pointer-events-none" />

                                    <div className="relative flex items-start justify-between">
                                        <div className={`w-12 h-12 rounded-xl flex items-center justify-center ${card.iconBg} shadow-sm group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300`}>
                                            <Icon size={22} />
                                        </div>

                                        <span className="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-slate-50 text-slate-500 border border-slate-200 group-hover:bg-[#EEF2F6] group-hover:text-emerald-600 group-hover:border-emerald-200 transition-colors">
                                            {card.badge}
                                        </span>
                                    </div>

                                    <div className="relative mt-5">
                                        <p className="text-xs font-semibold text-slate-400 tracking-widest">
                                            {card.title}
                                        </p>

                                        <div className="flex items-baseline gap-2 mt-1">
                                            {card.count !== null ? (
                                                <span className="text-3xl font-sans text-slate-800 tracking-tight tabular-nums">
                                                    {card.count}
                                                </span>
                                            ) : (
                                                <span className="text-lg font-semibold text-slate-700">
                                                    Accéder
                                                </span>
                                            )}
                                        </div>

                                        <p className="text-xs text-slate-500 mt-2 font-medium">
                                            {card.description}
                                        </p>
                                    </div>

                                    <div className="relative mt-5 pt-4 border-t border-slate-200 flex items-center justify-between text-xs font-semibold text-emerald-600">
                                        <span>Voir détails</span>
                                        <div className="w-6 h-6 rounded-full bg-[#EEF2F6] flex items-center justify-center group-hover:translate-x-1 group-hover:bg-[#14532D] group-hover:text-white transition-all">
                                            <ArrowUpRight size={13} />
                                        </div>
                                    </div>
                                </button>
                            );
                        })}
                    </div>
                </section>

                {/* COURBE D'ACTIVITÉ */}
                <section className="bg-white border border-slate-200 rounded-xl p-6 md:p-7 shadow-sm">
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                        <div className="flex items-center gap-3">
                            <div className="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center">
                                <TrendingUp size={20} />
                            </div>
                            <div>
                                <h3 className="text-base font-sans text-slate-800 tracking-tight">
                                    Activité des rendez-vous
                                </h3>
                                <p className="text-xs text-slate-500 mt-0.5">
                                    Évolution sur les 6 derniers mois
                                </p>
                            </div>
                        </div>

                        <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-50 border border-slate-200 text-[11px] font-semibold text-slate-500 self-start sm:self-auto">
                            <CheckCircle2 size={13} className="text-[#2F5D50]" />
                            Données synchronisées
                        </span>
                    </div>

                    {rdvParMois.some((d) => d.total > 0) ? (
                        <AreaChart data={rdvParMois} color="#14532D" />
                    ) : (
                        <div className="h-48 flex flex-col items-center justify-center text-center bg-slate-50/50 rounded-xl border border-dashed border-slate-200">
                            <CalendarDays size={32} className="text-[#94A3B8] mb-2" />
                            <p className="text-sm font-semibold text-slate-700">
                                Aucun rendez-vous sur cette période
                            </p>
                            <p className="text-xs text-slate-500 mt-0.5">
                                Vos prochains rendez-vous apparaîtront ici.
                            </p>
                        </div>
                    )}
                </section>
            </main>
        </div>
    );
}
