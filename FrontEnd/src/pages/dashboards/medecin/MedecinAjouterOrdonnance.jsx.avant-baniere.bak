import { useEffect, useState } from "react";
import { useSearchParams } from "react-router-dom";
import axios from "axios";
import { FilePlus2, Plus, Trash2, Loader2 } from "lucide-react";

const API_URL = "http://127.0.0.1:8000/api";
const todayISO = () => new Date().toISOString().substring(0, 10);

export default function MedecinAjouterOrdonnance() {
    const [searchParams] = useSearchParams();
    const patientIdParam = searchParams.get("patientId") || "";

    const [medecin, setMedecin] = useState(null);
    const [patients, setPatients] = useState([]);
    const [loading, setLoading] = useState(true);
    const [saving, setSaving] = useState(false);
    const [error, setError] = useState("");
    const [success, setSuccess] = useState("");
    const [form, setForm] = useState({
        patient_id: patientIdParam,
        date_ordonnance: todayISO(),
        notes: "",
    });
    const [lignes, setLignes] = useState([
        { medicament: "", dosage: "", frequence: "", duree: "", quantite: "" },
    ]);

    const token = localStorage.getItem("token") || sessionStorage.getItem("token");
    const config = {
        headers: { Accept: "application/json", Authorization: `Bearer ${token}` },
    };
    useEffect(() => {
        axios
            .get(`${API_URL}/medecin/dashboard`, config)
            .then((res) => {
                setMedecin(res.data.medecin || null);
                setPatients(res.data.patients || []);
            })
            .catch((err) =>
                setError(
                    err.response?.data?.message ||
                        "Impossible de charger vos donnees."
                )
            )
            .finally(() => setLoading(false));
    }, []);

    const changerForm = (champ, valeur) =>
        setForm((prev) => ({ ...prev, [champ]: valeur }));

    const changerLigne = (index, champ, valeur) =>
        setLignes((prev) =>
            prev.map((ligne, i) =>
                i === index ? { ...ligne, [champ]: valeur } : ligne
            )
        );
    const ajouterLigne = () =>
        setLignes((prev) => [
            ...prev,
            { medicament: "", dosage: "", frequence: "", duree: "", quantite: "" },
        ]);

    const retirerLigne = (index) =>
        setLignes((prev) =>
            prev.length > 1 ? prev.filter((_, i) => i !== index) : prev
        );

    const enregistrer = async (e) => {
        e.preventDefault();
        setError("");
        setSuccess("");

        if (!form.patient_id || !medecin?.id) {
            setError("Patient et medecin sont requis.");
            return;
        }
        const lignesValides = lignes.filter((l) => l.medicament.trim());
        if (lignesValides.length === 0) {
            setError("Ajoutez au moins un medicament.");
            return;
        }

        setSaving(true);

        try {
            const payload = {
                patient_id: Number(form.patient_id),
                medecin_id: Number(medecin.id),
                date_ordonnance: form.date_ordonnance,
                statut: "active",
                notes: form.notes || null,
                lignes: lignesValides.map((l) => ({
                    medicament: l.medicament.trim(),
                    dosage: l.dosage || null,
                    frequence: l.frequence || null,
                    duree: l.duree || null,
                    quantite: l.quantite ? Number(l.quantite) : null,
                })),
            };
            const res = await axios.post(`${API_URL}/ordonnances`, payload, config);
            setSuccess(res.data?.message || "Ordonnance creee avec succes.");
            setForm({ patient_id: "", date_ordonnance: todayISO(), notes: "" });
            setLignes([{ medicament: "", dosage: "", frequence: "", duree: "", quantite: "" }]);
        } catch (err) {
            setError(err.response?.data?.message || "Erreur lors de la creation de l'ordonnance.");
        } finally {
            setSaving(false);
        }
    };

    return (
        <div className="bg-slate-50 min-h-screen">
            <div className="max-w-7xl mx-auto px-6 lg:px-8 py-10 space-y-6">

                <div className="rounded-3xl bg-gradient-to-r from-[#14532D] to-[#059669] shadow-lg p-6 md:p-8">
                    <div className="flex items-center gap-4">
                        <div className="w-14 h-14 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center">
                            <FilePlus2 size={26} className="text-white" />
                        </div>
                        <div>
                            <p className="text-blue-200 text-xs font-semibold uppercase tracking-wider">
                                Espace Medecin
                            </p>
                            <h1 className="text-2xl md:text-3xl font-bold text-white mt-1">
                                Ajouter une ordonnance
                            </h1>
                            <p className="text-blue-100/80 text-sm mt-1">
                                Creez une nouvelle prescription pour l'un de vos patients.
                            </p>
                        </div>
                    </div>
                </div>
                {error && (
                    <div className="rounded-lg bg-red-50 p-4 text-sm text-red-700">
                        {error}
                    </div>
                )}

                {success && (
                    <div className="rounded-lg bg-green-50 p-4 text-sm text-green-700">
                        {success}
                    </div>
                )}

                {patientIdParam && (
                    <div className="rounded-lg bg-emerald-50 p-4 text-sm text-emerald-800">
                        Patient pre-selectionne depuis la fiche patient.
                    </div>
                )}

                {loading ? (
                    <div className="flex items-center justify-center py-16">
                        <Loader2 size={24} className="animate-spin text-emerald-600" />
                    </div>
                ) : (
                    <form
                        onSubmit={enregistrer}
                        className="rounded-2xl bg-white border border-slate-200 shadow-sm p-6 space-y-5"
                    >
                        <div className="grid md:grid-cols-2 gap-4">
                            <div>
                                <label className="block text-sm font-semibold text-slate-700 mb-1">
                                    Patient
                                </label>
                                <select
                                    value={form.patient_id}
                                    onChange={(e) =>
                                        changerForm("patient_id", e.target.value)
                                    }
                                    className="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm"
                                >
                                    <option value="">Selectionner un patient</option>
                                    {patients.map((p) => (
                                        <option key={p.id} value={p.id}>
                                            {p.prenom} {p.nom}
                                        </option>
                                    ))}
                                </select>
                            </div>
                            <div>
                                <label className="block text-sm font-semibold text-slate-700 mb-1">
                                    Date de l'ordonnance
                                </label>
                                <input
                                    type="date"
                                    value={form.date_ordonnance}
                                    onChange={(e) =>
                                        changerForm("date_ordonnance", e.target.value)
                                    }
                                    className="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm"
                                />
                            </div>
                        </div>

                        <div>
                            <div className="flex items-center justify-between mb-2">
                                <h2 className="text-sm font-semibold text-slate-700">
                                    Medicaments prescrits
                                </h2>
                                <button
                                    type="button"
                                    onClick={ajouterLigne}
                                    className="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 text-white px-3 py-1.5 text-xs font-semibold hover:bg-emerald-700"
                                >
                                    <Plus size={14} /> Ajouter un medicament
                                </button>
                            </div>

                            <div className="space-y-3">
                                {lignes.map((ligne, index) => (
                                    <div
                                        key={index}
                                        className="rounded-xl border border-slate-200 bg-slate-50 p-3 grid md:grid-cols-5 gap-2"
                                    >
                                        <input
                                            value={ligne.medicament}
                                            onChange={(e) =>
                                                changerLigne(index, "medicament", e.target.value)
                                            }
                                            placeholder="Medicament"
                                            className="rounded-lg border border-slate-300 px-3 py-2 text-sm md:col-span-1"
                                        />
                                        <input
                                            value={ligne.dosage}
                                            onChange={(e) =>
                                                changerLigne(index, "dosage", e.target.value)
                                            }
                                            placeholder="Dosage"
                                            className="rounded-lg border border-slate-300 px-3 py-2 text-sm"
                                        />
                                        <input
                                            value={ligne.frequence}
                                            onChange={(e) =>
                                                changerLigne(index, "frequence", e.target.value)
                                            }
                                            placeholder="Frequence"
                                            className="rounded-lg border border-slate-300 px-3 py-2 text-sm"
                                        />
                                        <input
                                            value={ligne.duree}
                                            onChange={(e) =>
                                                changerLigne(index, "duree", e.target.value)
                                            }
                                            placeholder="Duree (jours)"
                                            className="rounded-lg border border-slate-300 px-3 py-2 text-sm"
                                        />
                                        <input
                                            value={ligne.quantite}
                                            onChange={(e) =>
                                                changerLigne(index, "quantite", e.target.value)
                                            }
                                            placeholder="Quantite"
                                            type="number"
                                            className="rounded-lg border border-slate-300 px-3 py-2 text-sm"
                                        />
                                        <button
                                            type="button"
                                            onClick={() => retirerLigne(index)}
                                            disabled={lignes.length === 1}
                                            className="md:col-span-5 justify-self-end inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs text-red-600 hover:bg-red-50 disabled:opacity-40"
                                        >
                                            <Trash2 size={13} /> Retirer
                                        </button>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <div>
                            <label className="block text-sm font-semibold text-slate-700 mb-1">
                                Notes (optionnel)
                            </label>
                            <textarea
                                value={form.notes}
                                onChange={(e) => changerForm("notes", e.target.value)}
                                rows={3}
                                placeholder="Instructions complementaires..."
                                className="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm"
                            />
                        </div>

                        <div className="flex justify-end">
                            <button
                                type="submit"
                                disabled={saving}
                                className="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 text-sm font-semibold text-white hover:bg-emerald-700 disabled:opacity-50"
                            >
                                {saving ? "Enregistrement..." : "Enregistrer l'ordonnance"}
                            </button>
                        </div>
                    </form>
                )}
            </div>
        </div>
    );
}
