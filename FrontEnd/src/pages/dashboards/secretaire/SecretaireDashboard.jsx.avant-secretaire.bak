import React, { useEffect, useState, useMemo } from "react";
import { useNavigate } from "react-router-dom";
import axios from "axios";
import BlocageAbonnement, {
    useAbonnementCabinet,
} from "../../../components/BlocageAbonnement";
import {
    CalendarDays, Users, MessageCircle, User, Home, LogOut,
    ChevronRight, HeartPulse, Clock, Stethoscope, TrendingUp,
    CheckCircle2, Plus, XCircle, AlertCircle, X, Lock, Check, UserPlus
} from "lucide-react";

const API_URL = "http://127.0.0.1:8000/api";

// Plages horaires standards de consultation
const DEFAULT_TIME_SLOTS = [
    "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "11:30", "12:00",
    "14:00", "14:30", "15:00", "15:30", "16:00", "16:30", "17:00", "17:30"
];

const normalizeTime = (timeStr) => {
    if (!timeStr) return "";
    const parts = timeStr.trim().split(":");
    if (parts.length >= 2) return `${parts[0].padStart(2, "0")}:${parts[1].padStart(2, "0")}`;
    return timeStr;
};

/* =====================================================
   OUTILS D'AFFICHAGE
===================================================== */
const getStatusBadge = (statut) => {
    const s = String(statut || "").toLowerCase();

    if (["confirm", "valide"].some((k) => s.includes(k))) {
        return "border-emerald-200 bg-[#EEF4F1] text-[#264A40]";
    }
    if (["attente", "en cours"].some((k) => s.includes(k))) {
        return "border-amber-200 bg-[#F8F3E7] text-amber-700";
    }
    if (["annul", "refus", "rejete"].some((k) => s.includes(k))) {
        return "border-rose-200 bg-[#F8EFEF] text-rose-700";
    }
    if (["termin"].some((k) => s.includes(k))) {
        return "border-sky-200 bg-[#EEF2F6] text-[#4C1D95]";
    }
    return "border-[#E7E1D5] bg-[#EDE8DD] text-[#4A453D]";
};

/* =====================================================
   COURBE (SVG natif avec lissage Bézier et tooltips)
===================================================== */
function AreaChart({ data, color = "#2563eb", height = 230 }) {
    const [hoveredPoint, setHoveredPoint] = useState(null);
    const w = 660;
    const h = height;
    const padX = 40;
    const padTop = 24;
    const padBottom = 34;
    const max = Math.max(1, ...data.map((d) => d.total));
    const innerW = w - padX * 2;
    const innerH = h - padTop - padBottom;
    const stepX = data.length > 1 ? innerW / (data.length - 1) : 0;

    const points = data.map((d, i) => ({
        x: padX + stepX * i,
        y: padTop + innerH - (d.total / max) * innerH,
        ...d,
        index: i,
    }));

    const pathD = points.reduce((path, point, index, array) => {
        if (index === 0) return `M ${point.x},${point.y}`;
        const previous = array[index - 1];
        const controlX = (previous.x + point.x) / 2;
        return `${path} C ${controlX},${previous.y} ${controlX},${point.y} ${point.x},${point.y}`;
    }, "");

    const last = points[points.length - 1];
    const first = points[0];
    const areaD = points.length > 0
        ? `${pathD} L ${last?.x ?? padX},${padTop + innerH} L ${first?.x ?? padX},${padTop + innerH} Z`
        : "";

    const gradId = `sec-area-${color.replace("#", "")}`;

    return (
        <div className="relative w-full overflow-x-auto">
            <svg viewBox={`0 0 ${w} ${h}`} className="w-full min-w-[520px] h-auto">
                <defs>
                    <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stopColor={color} stopOpacity="0.15" />
                        <stop offset="100%" stopColor={color} stopOpacity="0.01" />
                    </linearGradient>
                </defs>

                {[0, 0.5, 1].map((f, i) => {
                    const y = padTop + innerH * (1 - f);
                    return (
                        <g key={i}>
                            <line x1={padX} x2={w - padX} y1={y} y2={y} stroke="#f1f5f9" strokeWidth="1.5" strokeDasharray={f === 0 ? "none" : "4 4"} />
                            <text x={padX - 10} y={y + 4} textAnchor="end" fontSize="10.5" fontWeight="600" fill="#94a3b8">
                                {Math.round(max * f)}
                            </text>
                        </g>
                    );
                })}

                {areaD && <path d={areaD} fill={`url(#${gradId})`} />}
                {pathD && <path d={pathD} fill="none" stroke={color} strokeWidth="3.5" strokeLinecap="round" strokeLinejoin="round" />}

                {points.map((p) => {
                    const isHovered = hoveredPoint?.index === p.index;
                    return (
                        <g key={p.index}>
                            <circle
                                cx={p.x}
                                cy={p.y}
                                r={isHovered ? 7 : p.total > 0 ? 4.5 : 3}
                                fill="white"
                                stroke={color}
                                strokeWidth={isHovered ? 3.5 : 2.5}
                                className="cursor-pointer transition-all duration-200"
                                onMouseEnter={() => setHoveredPoint(p)}
                                onMouseLeave={() => setHoveredPoint(null)}
                            />
                            <text x={p.x} y={h - 10} textAnchor="middle" fontSize="11" fontWeight="700" fill={isHovered ? color : "#64748b"}>
                                {p.label}
                            </text>
                        </g>
                    );
                })}
            </svg>
            {hoveredPoint && (
                <div
                    className="absolute bg-slate-900 text-white text-xs rounded-xl px-3 py-1.5 shadow-xl pointer-events-none z-10 -translate-x-1/2 -translate-y-full font-medium"
                    style={{ left: `${(hoveredPoint.x / w) * 100}%`, top: `${(hoveredPoint.y / h) * 100}%`, marginTop: "-10px" }}
                >
                    <span className="text-blue-300 font-bold">{hoveredPoint.label}</span> : {hoveredPoint.total} rendez-vous
                </div>
            )}
        </div>
    );
}

export default function SecretaireDashboard() {
    const navigate = useNavigate();

    // Abonnement du cabinet : l'espace est bloqué s'il n'est plus actif
    const {
        statut: statutAbo,
        dateFin,
        bloque: cabinetBloque,
    } = useAbonnementCabinet();
    const [secretaire, setSecretaire] = useState(null);
    const [stats, setStats] = useState({ rendez_vous: 0, patients: 0, medecins: 0 });
    const [rdvParMois, setRdvParMois] = useState([]);
    const [loading, setLoading] = useState(true);
    const [activeTab, setActiveTab] = useState("dashboard");

    // Modal Nouveau RDV
    const [showRdvModal, setShowRdvModal] = useState(false);
    const [medecins, setMedecins] = useState([]);
    const [patients, setPatients] = useState([]);
    const [allRdv, setAllRdv] = useState([]);
    const [saving, setSaving] = useState(false);
    const [formError, setFormError] = useState("");
    const [formSuccess, setFormSuccess] = useState("");
    const [formData, setFormData] = useState({
        medecin_id: "",
        patient_id: "",
        date_rdv: new Date().toISOString().split("T")[0],
        heure_rdv: "",
        motif: "",
        statut: "Confirmé",
    });

    // Un seul médecin associé (règle métier : un cabinet = un médecin) :
    // il est présélectionné à l'ouverture du formulaire de RDV.
    const medecinUnique = medecins.length === 1 ? medecins[0] : null;

    useEffect(() => {
        if (showRdvModal && medecinUnique && !formData.medecin_id) {
            setFormData((prev) => ({
                ...prev,
                medecin_id: String(medecinUnique.id),
            }));
        }
    }, [showRdvModal, medecinUnique, formData.medecin_id]);

    useEffect(() => {
        getDashboard();
    }, []);

    const getHeaders = () => {
        const token = localStorage.getItem("token");
        return {
            Authorization: `Bearer ${token}`,
            Accept: "application/json",
        };
    };

    const getDashboard = async () => {
        try {
            const token = localStorage.getItem("token");
            if (!token) {
                navigate("/login");
                return;
            }

            const response = await axios.get(`${API_URL}/secretaire/dashboard`, {
                headers: {
                    Authorization: `Bearer ${token}`,
                    Accept: "application/json",
                },
            });

            setSecretaire(response.data.user);
            setStats(response.data.stats || { rendez_vous: 0, patients: 0, medecins: 0 });
            setRdvParMois(
                (response.data.rendez_vous_par_mois || []).map((m) => ({
                    ...m,
                    label: new Date(`${m.mois}-01`).toLocaleDateString("fr-FR", { month: "short" }),
                }))
            );

            // Tous les RDV (pour le bloc « RDV du jour »)
            const rdvRes = await axios.get(`${API_URL}/rendez-vous`, {
                headers: {
                    Authorization: `Bearer ${token}`,
                    Accept: "application/json",
                },
            });
            setAllRdv(rdvRes.data.data || []);
        } catch (error) {
            console.error("Erreur dashboard secrétaire :", error);
            if (error.response?.status === 401) {
                localStorage.removeItem("token");
                localStorage.removeItem("user");
                navigate("/login");
            }
        } finally {
            setLoading(false);
        }
    };

    // =====================================================
    // RDV DU JOUR (seuls les rendez-vous de la date du jour)
    // =====================================================
    const now = new Date();
    const aujourdhuiISO = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;

    const rdvDuJour = useMemo(() => {
        return allRdv
            .filter((r) => {
                const annule = ["annulé", "annule", "annulée"].includes(
                    String(r.statut || "").toLowerCase()
                );
                return (
                    !annule &&
                    String(r.date_rdv).split("T")[0] === aujourdhuiISO
                );
            })
            .sort((a, b) =>
                String(a.heure_rdv || "").localeCompare(String(b.heure_rdv || ""))
            );
    }, [allRdv, aujourdhuiISO]);

    const chargerDonneesModal = async () => {
        try {
            const headers = getHeaders();
            const [resMed, resPat, resRdv] = await Promise.all([
                axios.get(`${API_URL}/medecins`, { headers }),
                axios.get(`${API_URL}/patients`, { headers }),
                axios.get(`${API_URL}/rendez-vous`, { headers }),
            ]);
            setMedecins(resMed.data.data || []);
            setPatients(resPat.data.data || []);
            setAllRdv(resRdv.data.data || []);
        } catch (err) {
            console.error("Erreur chargement données modal :", err);
        }
    };

    const openRdvModal = async () => {
        setFormError("");
        setFormSuccess("");
        setFormData({
            medecin_id: "",
            patient_id: "",
            date_rdv: new Date().toISOString().split("T")[0],
            heure_rdv: "",
            motif: "",
            statut: "Confirmé",
            mode: "presentiel",
        });
        setShowRdvModal(true);
        await chargerDonneesModal();
    };

    const creneauxDisponibilite = useMemo(() => {
        if (!formData.medecin_id || !formData.date_rdv) return [];

        const medecinRdvDuJour = allRdv.filter((r) => {
            const sameMedecin = String(r.medecin_id || r.medecin?.id) === String(formData.medecin_id);
            const sameDate = String(r.date_rdv).split("T")[0] === String(formData.date_rdv);
            const notCancelled = String(r.statut || "").toLowerCase() !== "annulé" && String(r.statut || "").toLowerCase() !== "annule";
            return sameMedecin && sameDate && notCancelled;
        });

        const bookedTimes = medecinRdvDuJour.map((r) => normalizeTime(r.heure_rdv));

        return DEFAULT_TIME_SLOTS.map((slot) => {
            const isBooked = bookedTimes.includes(normalizeTime(slot));
            const bookedRdv = isBooked
                ? medecinRdvDuJour.find((r) => normalizeTime(r.heure_rdv) === normalizeTime(slot))
                : null;
            return {
                time: slot,
                isAvailable: !isBooked,
                bookedWith: bookedRdv ? `${bookedRdv.patient?.prenom || ""} ${bookedRdv.patient?.nom || "Patient"}`.trim() : null,
            };
        });
    }, [formData.medecin_id, formData.date_rdv, allRdv]);

    const totalDisponibles = useMemo(() => creneauxDisponibilite.filter((c) => c.isAvailable).length, [creneauxDisponibilite]);

    const handlePrendreRendezVous = async (e) => {
        e.preventDefault();
        setFormError("");

        if (!formData.medecin_id) { setFormError("Veuillez sélectionner un médecin."); return; }
        if (!formData.patient_id) { setFormError("Veuillez sélectionner un patient."); return; }
        if (!formData.date_rdv) { setFormError("Veuillez choisir une date."); return; }
        if (!formData.heure_rdv) { setFormError("Veuillez sélectionner un créneau horaire."); return; }

        try {
            setSaving(true);
            const token = localStorage.getItem("token");
            if (!token) { navigate("/login"); return; }

            await axios.post(`${API_URL}/rendez-vous`, {
                medecin_id: formData.medecin_id,
                patient_id: formData.patient_id,
                date_rdv: formData.date_rdv,
                heure_rdv: formData.heure_rdv,
                motif: formData.motif || "Consultation",
                statut: formData.statut || "Confirmé",
                mode: formData.mode || "presentiel",
            }, {
                headers: {
                    Authorization: `Bearer ${token}`,
                    Accept: "application/json",
                    "Content-Type": "application/json",
                },
            });

            setFormSuccess("Rendez-vous enregistré avec succès !");
            setTimeout(() => {
                setShowRdvModal(false);
                setFormSuccess("");
            }, 1500);
            await getDashboard();
        } catch (err) {
            console.error("Erreur création RDV :", err);
            if (err.response?.data?.errors) {
                const msgs = Object.values(err.response.data.errors).flat().join(" ");
                setFormError(msgs);
            } else {
                setFormError(err.response?.data?.message || "Erreur lors de l'enregistrement du rendez-vous.");
            }
        } finally {
            setSaving(false);
        }
    };

    const logout = async () => {
        try {
            const token = localStorage.getItem("token");
            await axios.post(`${API_URL}/logout`, {}, {
                headers: { Authorization: `Bearer ${token}` }
            });
        } catch (error) {
            console.error(error);
        }
        localStorage.removeItem("token");
        localStorage.removeItem("user");
        navigate("/login");
    };

    if (loading) {
        return (
            <div className="min-h-screen bg-[#F6F3EE] flex items-center justify-center">
                <div className="rounded-md border border-[#E7E1D5] bg-white p-10 text-center shadow-[0_1px_3px_rgba(28,27,25,0.06)]">
                    <div className="w-12 h-12 border-[3px] border-sky-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                    <p className="text-sm text-[#8C8577] font-medium">Chargement de votre espace...</p>
                </div>
            </div>
        );
    }

    const menu = [
        { id: "dashboard", label: "Accueil", icon: Home, path: "/secretaire/dashboard" },
        { id: "rendez-vous", label: "Rendez-vous & Planning", icon: CalendarDays, path: "/secretaire/rendez-vous" },
        { id: "patients", label: "Gestion Patients", icon: Users, header: true },
        { id: "patients-ajouter", label: "Ajouter patient", icon: UserPlus, path: "/secretaire/patients/ajouter", sub: true },
        { id: "patients-liste", label: "Liste patients", icon: Users, path: "/secretaire/patients", sub: true },
        { id: "horaires", label: "Horaires", icon: CalendarDays, path: "/secretaire/horaires" },
        { id: "messages", label: "Messagerie", icon: MessageCircle, path: "/secretaire/messages" },
        { id: "profil", label: "Mon profil", icon: User, path: "/secretaire/profil" },
    ];

    const cardColors = [
        { light: "bg-[#EEF2F6]", text: "text-[#4C1D95]", ring: "hover:ring-[#DDE5EC]" },
        { light: "bg-[#EEF4F1]", text: "text-[#2F5D50]", ring: "hover:ring-[#DCE8E4]" },
        { light: "bg-[#E6F3F7]", text: "text-[#0E516A]", ring: "hover:ring-[#CBE3EA]" },
        { light: "bg-[#F8F3E7]", text: "text-[#8A6D1F]", ring: "hover:ring-[#EEE5CE]" },
    ];

    const cards = [
        {
            title: "Rendez-vous",
            description: "Planning global du cabinet",
            icon: CalendarDays,
            count: stats.rendez_vous,
            path: "/secretaire/rendez-vous",
        },
        {
            title: "Patients",
            description: "Fichiers & dossiers patients",
            icon: Users,
            count: stats.patients,
            path: "/secretaire/patients",
        },
        {
            title: "Messagerie",
            description: "Communications & demandes",
            icon: MessageCircle,
            count: null,
            path: "/secretaire/messages",
        },
    ];

    const handleMenuClick = (item) => {
        if (item.id === "dashboard") {
            setActiveTab("dashboard");
        } else {
            navigate(item.path);
        }
    };

    const isMenuActive = (item) => item.id === "dashboard" && activeTab === "dashboard";

    const today = new Date();
    const hour = today.getHours();
    const greeting = hour < 12 ? "Bonjour" : hour < 18 ? "Bon après-midi" : "Bonsoir";
    const initial = secretaire?.prenom?.charAt(0)?.toUpperCase() || "S";
    const fullName = `${secretaire?.prenom || ""} ${secretaire?.nom || ""}`.trim();

    if (cabinetBloque) {
        return (
            <div className="min-h-screen bg-[#F6F3EE]">
                <BlocageAbonnement
                    statut={statutAbo}
                    dateFin={dateFin}
                    espace="secretaire"
                />
            </div>
        );
    }

    return (
        <div className="min-h-screen bg-[#F6F3EE] flex">
            {/* SIDEBAR (desktop) */}
            <aside className="hidden lg:flex w-64 bg-white border-r border-[#E7E1D5] min-h-screen flex-col sticky top-0 h-screen">
                {/* Logo */}
                <div className="px-5 py-5 border-b border-[#EDE8DD]">
                    <div className="flex items-center gap-3">
                        <div className="w-10 h-10 bg-gradient-to-br from-[#4C1D95] to-[#4C1D95] rounded-xl flex items-center justify-center shadow-md shadow-blue-200">
                            <HeartPulse size={20} className="text-white" />
                        </div>
                        <div>
                            <span className="block text-lg font-bold text-[#1C1B19] leading-tight">MedPlatform</span>
                            <span className="block text-[11px] font-medium text-[#A39A89] tracking-wider">Espace secrétariat</span>
                        </div>
                    </div>
                </div>

                
                {/* Navigation */}
                <nav className="px-3 flex-1 space-y-1 overflow-y-auto">
                    {menu.map((item) => {
                        const isActive = isMenuActive(item);
                        const Icon = item.icon;

                        // Groupe « Gestion Patients » (titre non cliquable)
                        if (item.header) {
                            return (
                                <div
                                    key={item.id}
                                    className="flex items-center gap-3 px-4 pt-4 pb-2 text-[11px] font-bold uppercase tracking-wider text-[#A39A89]"
                                >
                                    <Icon size={15} />
                                    {item.label}
                                </div>
                            );
                        }

                        return (
                            <button
                                key={item.id}
                                onClick={() => handleMenuClick(item)}
                                className={`relative w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-left transition-colors duration-200 group ${
                                    item.sub ? " !pl-9" : ""
                                }${
                                    isActive ? "bg-[#EEF2F6] text-violet-700 font-semibold" : "text-[#4A453D] hover:bg-[#EDE8DD] hover:text-[#1C1B19]"
                                }`}
                            >
                                {isActive && <span className="absolute left-0 top-1/2 -translate-y-1/2 h-6 w-1 rounded-full bg-[#4C1D95]" />}
                                <Icon size={19} className={isActive ? "text-[#4C1D95]" : "text-[#A39A89] group-hover:text-[#4C1D95]"} />
                                <span className="text-sm">{item.label}</span>
                                {isActive && <ChevronRight size={15} className="ml-auto text-blue-400" />}
                            </button>
                        );
                    })}
                </nav>

                {/* Logout */}
                <div className="p-3 border-t border-[#EDE8DD]">
                    <button onClick={logout} className="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-[#7A2E33] hover:bg-[#F8EFEF] transition-colors duration-200 group">
                        <LogOut size={19} className="text-[#8C444A] group-hover:text-rose-500" />
                        <span className="text-sm font-medium">Déconnexion</span>
                    </button>
                </div>
            </aside>

            {/* MAIN CONTENT */}
            <main className="flex-1 min-w-0 p-4 sm:p-6 lg:p-8 overflow-y-auto">
                {/* BARRE MOBILE */}
                <div className="lg:hidden flex items-center justify-between px-1 mb-4">
                    <div className="flex items-center gap-2.5">
                        <div className="w-9 h-9 bg-gradient-to-br from-[#4C1D95] to-[#4C1D95] rounded-lg flex items-center justify-center">
                            <HeartPulse size={18} className="text-white" />
                        </div>
                        <span className="font-bold text-[#1C1B19]">MedPlatform</span>
                    </div>
                    <div className="flex items-center gap-2">
                        <button onClick={logout} aria-label="Déconnexion" className="w-9 h-9 flex items-center justify-center rounded-lg text-rose-500 hover:bg-[#F8EFEF] transition">
                            <LogOut size={18} />
                        </button>
                        <div className="w-9 h-9 rounded-full bg-gradient-to-br from-[#4C1D95] to-[#4C1D95] text-white flex items-center justify-center font-bold text-sm">
                            {initial}
                        </div>
                    </div>
                </div>

                {/* NAVIGATION MOBILE */}
                <div className="lg:hidden -mx-4 px-4 mb-6 overflow-x-auto flex gap-2 pb-1">
                    {menu.map((item) => {
                        const isActive = isMenuActive(item);
                        const Icon = item.icon;

                        // Groupe « Gestion Patients » (titre non cliquable)
                        if (item.header) {
                            return (
                                <div
                                    key={item.id}
                                    className="flex shrink-0 items-center gap-2 px-4 py-2 text-[11px] font-bold uppercase tracking-wider text-[#A39A89]"
                                >
                                    <Icon size={15} />
                                    {item.label}
                                </div>
                            );
                        }

                        return (
                            <button
                                key={item.id}
                                onClick={() => handleMenuClick(item)}
                                className={`flex shrink-0 items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition ${
                                    item.sub ? " !pl-8" : ""
                                }${
                                    isActive ? "bg-[#4C1D95] text-white shadow-[0_1px_3px_rgba(28,27,25,0.06)]" : "bg-white border border-[#E7E1D5] text-[#4A453D] hover:bg-[#EDE8DD]"
                                }`}
                            >
                                <Icon size={15} />
                                {item.label}
                            </button>
                        );
                    })}
                </div>

                {/* BANNIÈRE DE BIENVENUE */}
                <section className="relative overflow-hidden rounded-lg bg-gradient-to-r from-sky-600 via-[#4C1D95] to-[#4C1D95] p-6 sm:p-8 text-white shadow-lg shadow-blue-200/60 mb-8">
                    <div className="absolute -top-12 -right-12 h-44 w-44 rounded-full bg-white/10" />
                    <div className="absolute top-8 right-28 h-24 w-24 rounded-full bg-white/10" />
                    <div className="absolute -bottom-16 right-56 h-36 w-36 rounded-full bg-white/10" />
                    <div className="relative flex flex-wrap items-center justify-between gap-6">
                        <div>
                            <h1 className="mt-1 text-2xl sm:text-3xl font-bold">{greeting}, {fullName}</h1>
                            <p className="mt-2 flex items-center gap-2 text-sm text-[#DDE5EC]">
                                <CalendarDays size={15} />
                                {today.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long", year: "numeric" })}
                            </p>
                        </div>
                    </div>
                </section>

                {/* CARTES DE STATISTIQUES */}
                <section className="grid gap-5 mb-8 [grid-template-columns:repeat(auto-fit,minmax(230px,1fr))]">
                    {cards.map((card, index) => {
                        const color = cardColors[index % cardColors.length];
                        const Icon = card.icon;

                        return (
                            <button
                                key={index}
                                onClick={() => navigate(card.path)}
                                className={`group bg-white rounded-md p-5 text-left border border-[#E7E1D5] hover:border-violet-200 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 ring-1 ring-transparent ${color.ring}`}
                            >
                                <div className="flex items-start justify-between">
                                    <div className={`w-12 h-12 ${color.light} rounded-xl flex items-center justify-center transition-transform duration-200 group-hover:scale-110`}>
                                        <Icon size={22} className={color.text} />
                                    </div>
                                    {card.count !== null ? (
                                        <span className={`text-3xl font-bold ${color.text}`}>{card.count}</span>
                                    ) : (
                                        <span className="rounded-full bg-[#EDE8DD] px-2.5 py-1 text-[10px] font-semibold tracking-wide text-[#8C8577]">
                                            Nouveau
                                        </span>
                                    )}
                                </div>
                                <h3 className="font-semibold text-[#2A2825] mt-4 mb-1">{card.title}</h3>
                                <p className="text-sm text-[#A39A89]">{card.description}</p>
                                <div className="flex items-center gap-1 mt-3 text-xs font-medium text-[#A39A89] group-hover:text-[#4C1D95] transition-colors">
                                    <span>Voir détails</span>
                                    <ChevronRight size={14} className="group-hover:translate-x-1 transition-transform" />
                                </div>
                            </button>
                        );
                    })}
                </section>

                {/* GRAPHIQUE D'ACTIVITÉ & DERNIERS RENDEZ-VOUS */}
                <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <section className="lg:col-span-2 bg-white rounded-md border border-[#E7E1D5] p-6 shadow-[0_1px_3px_rgba(28,27,25,0.06)]">
                        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                            <div className="flex items-center gap-3">
                                <div className="w-10 h-10 bg-[#EEF2F6] rounded-xl flex items-center justify-center">
                                    <TrendingUp size={20} className="text-[#4C1D95]" />
                                </div>
                                <div>
                                    <h3 className="font-bold text-[#1C1B19]">Flux des rendez-vous</h3>
                                    <p className="text-sm text-[#A39A89]">Évolution des consultations (6 mois)</p>
                                </div>
                            </div>
                            <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#EEF4F1] border border-[#DCE8E4] text-[11px] font-bold text-[#2F5D50] self-start sm:self-auto">
                                <CheckCircle2 size={13} className="text-[#2F5D50]" />
                                Données synchronisées
                            </span>
                        </div>
                        {rdvParMois.some((d) => d.total > 0) ? (
                            <AreaChart data={rdvParMois} color="#4C1D95" />
                        ) : (
                            <div className="h-48 flex flex-col items-center justify-center text-center bg-[#F6F3EE] rounded-md border border-dashed border-[#E7E1D5]">
                                <CalendarDays size={32} className="text-[#C7BEAC] mb-2" />
                                <p className="text-sm font-bold text-[#4A453D]">Aucun rendez-vous pour le moment</p>
                                <p className="text-xs text-[#A39A89] mt-0.5">Les prochains rendez-vous apparaîtront ici.</p>
                            </div>
                        )}
                    </section>

                    <section className="bg-white rounded-md border border-[#E7E1D5] p-6 shadow-[0_1px_3px_rgba(28,27,25,0.06)] flex flex-col justify-between">
                        <div>
                            <div className="flex items-center justify-between mb-5">
                                <div className="flex items-center gap-2.5">
                                    <div className="w-10 h-10 bg-[#EEF2F6] rounded-xl flex items-center justify-center">
                                        <CalendarDays size={18} className="text-[#4C1D95]" />
                                    </div>
                                    <div>
                                        <h3 className="font-bold text-[#1C1B19]">RDV du jour</h3>
                                        <p className="text-[11px] text-[#A39A89]">
                                            {now.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long" })}
                                        </p>
                                    </div>
                                </div>
                                <button type="button" onClick={() => navigate("/secretaire/rendez-vous")} className="text-xs font-bold text-[#4C1D95] hover:underline cursor-pointer">
                                    Tout voir
                                </button>
                            </div>
                            {rdvDuJour.length === 0 ? (
                                <div className="p-8 text-center bg-[#F6F3EE] rounded-md border border-dashed border-[#E7E1D5]">
                                    <p className="text-xs font-bold text-[#A39A89]">Aucun rendez-vous aujourd'hui</p>
                                </div>
                            ) : (
                                <div className="space-y-3">
                                    {rdvDuJour.slice(0, 6).map((rdv) => (
                                        <div key={rdv.id} className="p-3 rounded-md bg-[#F6F3EE] border border-[#E7E1D5] hover:bg-[#EDE8DD] transition flex items-center justify-between">
                                            <div className="min-w-0 flex-1">
                                                <p className="text-xs font-bold text-[#2A2825] truncate">{rdv.patient?.prenom} {rdv.patient?.nom}</p>
                                                <p className="text-[10px] text-[#8C8577] flex items-center gap-1 mt-0.5">
                                                    <span>Dr. {rdv.medecin?.nom}</span> • <span className="font-bold text-[#4C1D95]">{String(rdv.heure_rdv || "").slice(0, 5)}</span>
                                                </p>
                                            </div>
                                            <span className={`shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-bold ${getStatusBadge(rdv.statut)}`}>
                                                {rdv.statut || "Confirmé"}
                                            </span>
                                        </div>
                                    ))}
                                </div>
                            )}
                        </div>
                        <button type="button" onClick={openRdvModal} className="mt-5 w-full py-2.5 rounded-md bg-[#4C1D95] hover:bg-violet-700 text-white font-bold text-xs transition flex items-center justify-center gap-1.5 cursor-pointer">
                            <Plus size={14} />
                            Nouveau RDV selon créneaux
                        </button>
                    </section>
                </div>
            </main>

            {/* MODAL — NOUVEAU RENDEZ-VOUS */}
            {showRdvModal && (
                <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4">
                    <div className="bg-white rounded-md shadow-2xl border border-[#E7E1D5] w-full max-w-2xl max-h-[90vh] overflow-y-auto">
                        <div className="flex items-center justify-between px-6 py-5 border-b border-[#E7E1D5]">
                            <div className="flex items-center gap-3">
                                <div className="w-10 h-10 bg-[#EEF2F6] rounded-xl flex items-center justify-center">
                                    <CalendarDays size={20} className="text-[#4C1D95]" />
                                </div>
                                <div>
                                    <h2 className="text-base font-bold text-[#1C1B19]">Nouveau Rendez-vous</h2>
                                    <p className="text-[11px] text-[#A39A89]">Réservation selon les disponibilités du praticien</p>
                                </div>
                            </div>
                            <button type="button" onClick={() => setShowRdvModal(false)} className="w-8 h-8 rounded-xl bg-[#F6F3EE] hover:bg-[#F8EFEF] text-[#8C8577] hover:text-rose-600 flex items-center justify-center transition cursor-pointer">
                                <X size={16} />
                            </button>
                        </div>
                        <form onSubmit={handlePrendreRendezVous} className="p-6 space-y-5">
                            {formError && (
                                <div className="flex items-center gap-2 p-3 rounded-md bg-rose-50 border border-rose-200 text-rose-700 text-xs font-bold">
                                    <XCircle size={15} className="shrink-0" />
                                    {formError}
                                </div>
                            )}
                            {formSuccess && (
                                <div className="flex items-center gap-2 p-3 rounded-md bg-[#EEF4F1] border border-emerald-200 text-[#2F5D50] text-xs font-bold">
                                    <CheckCircle2 size={15} className="shrink-0" />
                                    {formSuccess}
                                </div>
                            )}
                            <div>
                                <label className="block text-xs font-bold text-[#4A453D] uppercase tracking-wider mb-1.5">
                                    <Stethoscope size={13} className="inline mr-1 text-[#4C1D95]" /> Médecin
                                </label>
                                <select
                                    value={formData.medecin_id}
                                    onChange={(e) => setFormData({ ...formData, medecin_id: e.target.value, heure_rdv: "" })}
                                    className="w-full px-4 py-3 rounded-md border border-[#E7E1D5] bg-[#F6F3EE] text-sm font-medium text-[#1C1B19] focus:outline-none focus:ring-2 focus:ring-[#4C1D95] transition"
                                    required
                                >
                                    <option value="">— Sélectionner un médecin —</option>
                                    {medecins.map((m) => (
                                        <option key={m.id} value={m.id}>
                                            Dr. {m.prenom} {m.nom} {m.specialite?.nom ? `— ${m.specialite.nom}` : ""}
                                        </option>
                                    ))}
                                </select>
                            </div>
                            <div>
                                <label className="block text-xs font-bold text-[#4A453D] uppercase tracking-wider mb-1.5">
                                    <User size={13} className="inline mr-1 text-[#4C1D95]" /> Patient
                                </label>
                                <select
                                    value={formData.patient_id}
                                    onChange={(e) => setFormData({ ...formData, patient_id: e.target.value })}
                                    className="w-full px-4 py-3 rounded-md border border-[#E7E1D5] bg-[#F6F3EE] text-sm font-medium text-[#1C1B19] focus:outline-none focus:ring-2 focus:ring-[#4C1D95] transition"
                                    required
                                >
                                    <option value="">— Sélectionner un patient —</option>
                                    {patients.map((p) => (
                                        <option key={p.id} value={p.id}>
                                            {p.prenom} {p.nom} {p.telephone ? `— ${p.telephone}` : ""}
                                        </option>
                                    ))}
                                </select>
                            </div>
                            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label className="block text-xs font-bold text-[#4A453D] uppercase tracking-wider mb-1.5">
                                        <CalendarDays size={13} className="inline mr-1 text-[#4C1D95]" /> Date du RDV
                                    </label>
                                    <input
                                        type="date"
                                        value={formData.date_rdv}
                                        onChange={(e) => setFormData({ ...formData, date_rdv: e.target.value, heure_rdv: "" })}
                                        className="w-full px-4 py-3 rounded-md border border-[#E7E1D5] bg-[#F6F3EE] text-sm font-medium text-[#1C1B19] focus:outline-none focus:ring-2 focus:ring-[#4C1D95] transition"
                                        required
                                    />
                                </div>
                                <div>
                                    <label className="block text-xs font-bold text-[#4A453D] uppercase tracking-wider mb-1.5">
                                        Type de consultation
                                    </label>
                                    <select
                                        value={formData.mode}
                                        onChange={(e) =>
                                            setFormData({
                                                ...formData,
                                                mode: e.target.value,
                                            })
                                        }
                                        className="w-full px-4 py-3 rounded-md border border-[#E7E1D5] bg-[#F6F3EE] text-sm font-medium text-[#1C1B19] focus:outline-none focus:ring-2 focus:ring-[#4C1D95] transition"
                                    >
                                        <option value="presentiel">
                                            Présentiel
                                        </option>
                                        <option value="video">
                                            En vidéo (téléconsultation)
                                        </option>
                                    </select>
                                    {formData.mode === "video" && (
                                        <p className="mt-1.5 text-[11px] font-semibold text-sky-700">
                                            Le patient recevra un lien Google
                                            Meet pour rejoindre la visio.
                                        </p>
                                    )}
                                </div>

                                <div>
                                    <label className="block text-xs font-bold text-[#4A453D] uppercase tracking-wider mb-1.5">
                                        <AlertCircle size={13} className="inline mr-1 text-amber-600" /> Motif
                                    </label>
                                    <input
                                        type="text"
                                        value={formData.motif}
                                        onChange={(e) => setFormData({ ...formData, motif: e.target.value })}
                                        placeholder="Consultation, Suivi, Urgence..."
                                        className="w-full px-4 py-3 rounded-md border border-[#E7E1D5] bg-[#F6F3EE] text-sm font-medium text-[#1C1B19] placeholder:text-[#8C8577] focus:outline-none focus:ring-2 focus:ring-[#4C1D95] transition"
                                    />
                                </div>
                            </div>
                            {formData.medecin_id && formData.date_rdv && (
                                <div>
                                    <div className="flex items-center justify-between mb-3">
                                        <label className="text-xs font-bold text-[#4A453D] uppercase tracking-wider">
                                            <Clock size={13} className="inline mr-1 text-[#4C1D95]" /> Créneaux disponibles
                                        </label>
                                        <span className="text-[11px] font-bold text-[#2F5D50] bg-[#EEF4F1] px-2.5 py-1 rounded-full border border-emerald-200">
                                            {totalDisponibles} / {DEFAULT_TIME_SLOTS.length} libres
                                        </span>
                                    </div>
                                    {creneauxDisponibilite.length > 0 ? (
                                        <>
                                            <p className="text-[10px] font-bold text-[#8C8577] uppercase tracking-widest mb-2">Matin</p>
                                            <div className="grid grid-cols-4 gap-2 mb-4">
                                                {creneauxDisponibilite.filter((c) => parseInt(c.time) < 13).map((creneau) => (
                                                    <button
                                                        key={creneau.time}
                                                        type="button"
                                                        disabled={!creneau.isAvailable}
                                                        onClick={() => setFormData({ ...formData, heure_rdv: creneau.time })}
                                                        className={`relative px-2 py-2.5 rounded-md text-xs font-bold transition-all cursor-pointer text-center ${
                                                            !creneau.isAvailable ? "bg-[#EDE8DD] text-[#8C8577] cursor-not-allowed border border-[#E7E1D5]" :
                                                            formData.heure_rdv === creneau.time ? "bg-[#4C1D95] text-white shadow-md ring-2 ring-blue-300 scale-105" :
                                                            "bg-[#EEF4F1] text-[#2F5D50] border border-emerald-200 hover:bg-[#DCE8E4] hover:scale-105"
                                                        }`}
                                                        title={creneau.isAvailable ? "Disponible" : `Occupé — ${creneau.bookedWith}`}
                                                    >
                                                        {!creneau.isAvailable && <Lock size={10} className="absolute top-1 right-1 text-[#A39A89]" />}
                                                        {formData.heure_rdv === creneau.time && <Check size={10} className="absolute top-1 right-1 text-white" />}
                                                        {creneau.time}
                                                    </button>
                                                ))}
                                            </div>
                                            <p className="text-[10px] font-bold text-[#8C8577] uppercase tracking-widest mb-2">Après-midi</p>
                                            <div className="grid grid-cols-4 gap-2">
                                                {creneauxDisponibilite.filter((c) => parseInt(c.time) >= 13).map((creneau) => (
                                                    <button
                                                        key={creneau.time}
                                                        type="button"
                                                        disabled={!creneau.isAvailable}
                                                        onClick={() => setFormData({ ...formData, heure_rdv: creneau.time })}
                                                        className={`relative px-2 py-2.5 rounded-md text-xs font-bold transition-all cursor-pointer text-center ${
                                                            !creneau.isAvailable ? "bg-[#EDE8DD] text-[#8C8577] cursor-not-allowed border border-[#E7E1D5]" :
                                                            formData.heure_rdv === creneau.time ? "bg-[#4C1D95] text-white shadow-md ring-2 ring-blue-300 scale-105" :
                                                            "bg-[#EEF4F1] text-[#2F5D50] border border-emerald-200 hover:bg-[#DCE8E4] hover:scale-105"
                                                        }`}
                                                        title={creneau.isAvailable ? "Disponible" : `Occupé — ${creneau.bookedWith}`}
                                                    >
                                                        {!creneau.isAvailable && <Lock size={10} className="absolute top-1 right-1 text-[#A39A89]" />}
                                                        {formData.heure_rdv === creneau.time && <Check size={10} className="absolute top-1 right-1 text-white" />}
                                                        {creneau.time}
                                                    </button>
                                                ))}
                                            </div>
                                        </>
                                    ) : (
                                        <div className="p-4 rounded-md bg-[#F6F3EE] border border-dashed border-[#E7E1D5] text-center">
                                            <p className="text-xs text-[#8C8577] font-medium">Sélectionnez un médecin et une date pour afficher les créneaux.</p>
                                        </div>
                                    )}
                                </div>
                            )}
                            <div className="flex items-center justify-end gap-3 pt-4 border-t border-[#E7E1D5]">
                                <button type="button" onClick={() => setShowRdvModal(false)} className="px-5 py-2.5 rounded-md bg-[#EDE8DD] hover:bg-[#E7E1D5] text-[#4A453D] font-bold text-xs transition cursor-pointer">
                                    Annuler
                                </button>
                                <button type="submit" disabled={saving || !formData.heure_rdv} className={`inline-flex items-center gap-2 px-6 py-2.5 rounded-md font-bold text-xs transition-all cursor-pointer ${
                                    saving || !formData.heure_rdv ? "bg-[#E7E1D5] text-[#8C8577] cursor-not-allowed" : "bg-[#4C1D95] hover:bg-violet-700 text-white shadow-md active:scale-95"
                                }`}>
                                    {saving ? (
                                        <><div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin" /> Enregistrement...</>
                                    ) : (
                                        <><Check size={15} /> Confirmer le RDV</>
                                    )}
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            )}
        </div>
    );
}
